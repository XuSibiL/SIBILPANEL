# ─────────────────────────────────────────────────────────────────────────────
#  نمونهٔ فایل محیطی (.env)
#  این فایل را به .env کپی کنید و مقادیر خودتان را بگذارید.
#  فایل .env هرگز در گیت کامیت نمی‌شود (در .gitignore هست).
#  کلیدهای قدیمی با پیشوند SIBIL_ هم خوانده می‌شوند، اما پیشوند رسمی PANEL_ است.
# ─────────────────────────────────────────────────────────────────────────────

# توکن ربات از @BotFather — اجباری
PANEL_BOT_TOKEN=

# شناسهٔ عددی مدیرانِ اولیه، با کاما جدا شده. در نخستین اجرا نقش‌های اضافی
# به «پشتیبانی» مهاجرت می‌شوند؛ مدیریت نقش‌ها از داخل ربات انجام می‌شود.
# مثال: 123456789,987654321
PANEL_ADMINS=

# مالک اصلیِ قفل‌شده (شناسهٔ عددی). این مقدار از DB همگام می‌شود و هیچ ادمینی
# نمی‌تواند آن را حذف یا تنزل دهد. در نصب جدید، همان اولین شناسهٔ PANEL_ADMINS است.
PANEL_PRIMARY_OWNER_ID=

# مسیر نصب (پیش‌فرض /opt/sibil)
PANEL_HOME=/opt/sibil

# مسیر دیتابیس SQLite (پیش‌فرض: $PANEL_HOME/sibil.sqlite3)
# PANEL_DB=

# نام نمایشی ربات روی پیام‌ها؛ خالی بگذارید تا از تنظیمات ربات خوانده شود
PANEL_BOT_NAME=

# یوزرنیم ربات بدون @ (برای ساخت لینک دعوت)
PANEL_BOT_USERNAME=

# هندل پشتیبانی بدون @ — هیچ هندلی داخل کد هاردکد نشده است
PANEL_SUPPORT_USERNAME=

# کانال رسمی خبر و بروزرسانی (از تنظیمات ربات هم قابل تغییر است)
PANEL_CHANNEL_URL=https://t.me/sibilpanel

# آدرس عمومی برای کال‌بک درگاه‌های پرداخت (https)
PANEL_WEB_URL=

# پورت وب‌هوک (پیش‌فرض 8080)
PANEL_WEB_PORT=8080

# ── بروزرسانی خودکار از گیت‌هاب ─────────────────────────────────────────────
# مخزن رسمی؛ دستور «sibil update» و دکمهٔ ربات از همین‌جا نسخهٔ تازه می‌گیرند.
PANEL_UPDATE_REPO=XuSibiL/SIBILPANEL
PANEL_UPDATE_BRANCH=main
# اگر می‌خواهید از آینه یا فایل محلی آپدیت کنید (اختیاری)
# PANEL_UPDATE_ARCHIVE_URL=
# PANEL_UPDATE_RESTART=0     # ری‌استارت خودکار را خاموش می‌کند
