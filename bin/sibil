#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════════
#  Sibil · CLI   (PHP edition)
#  Terminal control panel: status, update, backup, restore, logs, doctor, ssl
#
#  Run:             sibil
#  Direct:          sibil status | update | restart | start | stop | logs
#                   sibil backup | restore | domain | config | doctor | deps
#                   sibil ssl | fix | install | remove | uninstall | help | version
# ═══════════════════════════════════════════════════════════════════════════════
set -uo pipefail

# سازگاری با کلیدهای قدیمی
# مسیر نصب؛ نصب‌کننده همین خط را با مسیر واقعی جایگزین می‌کند
PANEL_HOME_DEFAULT="${PANEL_HOME_DEFAULT:-/opt/sibil}"
export PANEL_HOME="${PANEL_HOME:-${SIBIL_HOME:-$PANEL_HOME_DEFAULT}}"
export PANEL_BOT_TOKEN="${PANEL_BOT_TOKEN:-${SIBIL_BOT_TOKEN:-}}"
export PANEL_ADMINS="${PANEL_ADMINS:-${SIBIL_ADMINS:-}}"
export PANEL_PRIMARY_OWNER_ID="${PANEL_PRIMARY_OWNER_ID:-}"
export PANEL_DB="${PANEL_DB:-${SIBIL_DB:-}}"
export PANEL_WEB_URL="${PANEL_WEB_URL:-${SIBIL_WEB_URL:-}}"
export PANEL_WEB_PORT="${PANEL_WEB_PORT:-${SIBIL_WEB_PORT:-}}"
export PANEL_DOMAIN="${PANEL_DOMAIN:-${SIBIL_DOMAIN:-}}"
export PANEL_PHP_BIN="${PANEL_PHP_BIN:-${SIBIL_PHP_BIN:-}}"
PANEL="${PANEL_HOME}"
CLI_BRAND="Sibil"
# نسخه از خودِ ربات خوانده می‌شود؛ هیچ عددی در این اسکریپت هاردکد نیست
detect_version() {
    local v=""
    for f in "$PANEL_HOME/VERSION" "$(dirname "${BASH_SOURCE[0]:-$0}")/VERSION"; do
        [[ -f "$f" ]] && { v="$(tr -d ' \r\n' <"$f")"; break; }
    done
    if [[ -z "$v" && -f "$PANEL_HOME/sibil.php" ]]; then
        v="$(grep -m1 "const PANEL_VERSION" "$PANEL_HOME/sibil.php" 2>/dev/null \
            | sed "s/.*'\(.*\)'.*/\1/")"
    fi
    if [[ -z "$v" && -f "$(dirname "${BASH_SOURCE[0]:-$0}")/sibil.php" ]]; then
        v="$(grep -m1 "const PANEL_VERSION" "$(dirname "${BASH_SOURCE[0]:-$0}")/sibil.php" \
             | sed "s/.*'\(.*\)'.*/\1/")"
    fi
    printf '%s' "${v:-0.0.0}"
}
VERSION="$(detect_version)"
APP="$PANEL_HOME/sibil.php"
ENV_FILE="$PANEL_HOME/.env"
DB_FILE="$PANEL_HOME/sibil.sqlite3"
LOG_FILE="$PANEL_HOME/sibil.log"
SERVICE="sibil"
WEB_SERVICE="sibil-web"
PID_FILE="$PANEL_HOME/sibil.pid"
CLI_PATH="${PANEL_CLI_PATH:-/usr/local/bin/sibil}"
# Path overrides keep the operational commands testable without ever pointing
# at host configuration; production defaults remain the standard system paths.
SYSTEMD_DIR="${SIBIL_SYSTEMD_DIR:-/etc/systemd/system}"
UPDATE_URL_FILE="$PANEL_HOME/.installer-url"
DEFAULT_UPDATE_URL="${PANEL_UPDATE_URL:-}"
OFFICIAL_INSTALL_URL="https://raw.githubusercontent.com/XuSibiL/SIBILPANEL/main/install.sh"

# نام نمایشی از .env خوانده می‌شود؛ هیچ نام برندی در کد نیست
brand_name() {
    local n=""
    [[ -f "$ENV_FILE" ]] && n="$(grep -E '^PANEL_BOT_NAME=' "$ENV_FILE" 2>/dev/null \
        | head -1 | cut -d= -f2- | tr -d '"')"
    [[ -n "$n" ]] || n="$CLI_BRAND"
    printf '%s' "$n"
}

PHP_BIN=""
if [[ -f "$ENV_FILE" ]]; then
    PHP_BIN="$(grep -E '^PANEL_PHP_BIN=' "$ENV_FILE" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"')"
    [[ -x "$PHP_BIN" ]] || PHP_BIN=""
fi
[[ -n "$PHP_BIN" ]] || PHP_BIN="$(command -v php || echo php)"

if [[ -t 1 && "${TERM:-dumb}" != "dumb" ]]; then
    B=$'\033[1m'; DIM=$'\033[2m'; R=$'\033[0m'
    RED=$'\033[31m'; GRN=$'\033[32m'; YEL=$'\033[33m'; BLU=$'\033[34m'
    MAG=$'\033[35m'; CYN=$'\033[36m'
else
    B=""; DIM=""; R=""; RED=""; GRN=""; YEL=""; BLU=""; MAG=""; CYN=""
fi

say()  { printf '%s\n' "$*"; }
step() { printf '\n%s▸ %s%s\n' "$CYN$B" "$*" "$R"; }
ok()   { printf '  %s✓%s %s\n' "$GRN" "$R" "$*"; }
warn() { printf '  %s!%s %s\n' "$YEL" "$R" "$*"; }
bad()  { printf '  %s✗%s %s\n' "$RED" "$R" "$*"; }
line() { printf '%s\n' "  ─────────────────────────────────────────────"; }

is_root() { [[ ${EUID:-$(id -u)} -eq 0 ]]; }
# آیا می‌توان از کاربر ورودی گرفت؟ (اسکریپت/CI نه)
have_tty() { [[ -e /dev/tty ]] && { [[ -t 0 ]] || [[ -t 1 ]]; }; }
has_systemd() { [[ "${SIBIL_DISABLE_SYSTEMD:-0}" != "1" ]] && command -v systemctl >/dev/null 2>&1 && [[ -d /run/systemd/system ]]; }

db_query() {
    # db_query "<SQL>"  → هر خط یک ردیف (ستون‌ها با | جدا می‌شوند)
    "$PHP_BIN" -r '
        $db = $argv[1]; $sql = $argv[2];
        if (!is_file($db)) { exit(0); }
        try {
            $pdo = new PDO("sqlite:" . $db, null, null, [
                PDO::ATTR_ERRMODE => PDO::ERRMODE_SILENT,
                PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
            ]);
            $rows = $pdo->query($sql);
            if ($rows === false) { exit(0); }
            foreach ($rows as $row) {
                echo implode("|", array_map(fn($v) => (string) $v, array_slice($row, 0, 8))) . "\n";
            }
        } catch (Throwable $e) { exit(0); }
    ' "$DB_FILE" "$1" 2>/dev/null
}

env_get() {
    [[ -f "$ENV_FILE" ]] || return 0
    grep -E "^$1=" "$ENV_FILE" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"'"'"
}

env_set() {
    local key="$1" value="$2"
    [[ -f "$ENV_FILE" ]] || touch "$ENV_FILE"
    if grep -qE "^$key=" "$ENV_FILE"; then
        sed -i "s|^$key=.*|$key=\"$value\"|" "$ENV_FILE"
    else
        printf '%s="%s"\n' "$key" "$value" >>"$ENV_FILE"
    fi
}

# Match the database that the PHP application itself will use.  A relative
# legacy value remains relative to this installation, never to the caller CWD.
_configured_db="${PANEL_DB:-$(env_get PANEL_DB)}"
if [[ -n "$_configured_db" ]]; then
    [[ "$_configured_db" == /* ]] || _configured_db="$PANEL_HOME/$_configured_db"
    DB_FILE="$_configured_db"
    export PANEL_DB="$DB_FILE"
fi
unset _configured_db

db_file_is_under_home() { [[ "$DB_FILE" == "$PANEL_HOME"/* ]]; }

# Explicit ownership model.  Uninstall and TLS tooling may only touch files
# marked by Sibil or units whose WorkingDirectory/ExecStart prove they belong to
# this exact PANEL_HOME.  A matching domain name alone is never ownership.
SIBIL_OWNER_MARKER='SIBILPANEL-OWNED'
SIBIL_CADDY_IMPORT_BEGIN='# BEGIN SIBILPANEL-OWNED IMPORT'
SIBIL_CADDY_IMPORT_END='# END SIBILPANEL-OWNED IMPORT'

valid_domain() {
    local dom="${1,,}"
    [[ ${#dom} -le 253 ]] || return 1
    [[ "$dom" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$ ]]
}

normalize_domain() {
    local dom="${1,,}"
    dom="${dom#http://}"; dom="${dom#https://}"; dom="${dom%%/*}"; dom="${dom%.}"
    printf '%s' "$dom"
}

panel_home_owned() {
    [[ -d "$PANEL_HOME" && "$PANEL_HOME" != / && "$PANEL_HOME" != /opt ]] || return 1
    if [[ -f "$PANEL_HOME/.sibil-owned" ]] && grep -qx "$SIBIL_OWNER_MARKER" "$PANEL_HOME/.sibil-owned" 2>/dev/null; then
        return 0
    fi
    # Compatible ownership proof for releases before the marker existed.
    [[ -f "$APP" && -f "$ENV_FILE" ]] \
        && grep -q 'PANEL_VERSION' "$APP" 2>/dev/null \
        && grep -qE "^PANEL_HOME=[\"']?$(printf '%s' "$PANEL_HOME" | sed 's/[][\\.^$*+?{}|()]/\\&/g')" "$ENV_FILE" 2>/dev/null
}

unit_is_owned() {
    local unit="$1"
    [[ -f "$unit" ]] || return 1
    grep -q "$SIBIL_OWNER_MARKER" "$unit" 2>/dev/null && return 0
    grep -qF "WorkingDirectory=$PANEL_HOME" "$unit" 2>/dev/null \
        && grep -qF "$PANEL_HOME/sibil.php" "$unit" 2>/dev/null
}

bot_unit_file() { printf '%s/%s.service' "$SYSTEMD_DIR" "$SERVICE"; }
web_unit_file() { printf '%s/%s.service' "$SYSTEMD_DIR" "$WEB_SERVICE"; }
bot_unit_is_owned() { unit_is_owned "$(bot_unit_file)"; }
web_unit_is_owned() { unit_is_owned "$(web_unit_file)"; }

cli_is_owned() {
    local path="$1" target="" quoted_home
    [[ -e "$path" || -L "$path" ]] || return 1
    target="$(readlink -f "$path" 2>/dev/null || printf '%s' "$path")"
    quoted_home="PANEL_HOME_DEFAULT=\"$PANEL_HOME\""
    [[ "$target" == "$PANEL_HOME"/* ]] && return 0
    grep -qF "$SIBIL_OWNER_MARKER" "$path" 2>/dev/null && return 0
    grep -qF "$quoted_home" "$path" 2>/dev/null && return 0
    grep -qF "PANEL_HOME_DEFAULT=$PANEL_HOME" "$path" 2>/dev/null && return 0
    grep -qF "$PANEL_HOME/sibil.php" "$path" 2>/dev/null
}

caddy_conf_dir() { printf '%s' "${SIBIL_CADDY_CONF_DIR:-/etc/caddy/conf.d}"; }
caddy_main_file() { printf '%s' "${SIBIL_CADDYFILE:-/etc/caddy/Caddyfile}"; }
caddy_site_file() { printf '%s/sibil-%s.caddy' "$(caddy_conf_dir)" "$1"; }
nginx_sites_enabled_dir() { printf '%s' "${SIBIL_NGINX_SITES_ENABLED_DIR:-/etc/nginx/sites-enabled}"; }
nginx_sites_available_dir() { printf '%s' "${SIBIL_NGINX_SITES_AVAILABLE_DIR:-/etc/nginx/sites-available}"; }
nginx_conf_dir() { printf '%s' "${SIBIL_NGINX_CONF_DIR:-/etc/nginx/conf.d}"; }
cron_dir() { printf '%s' "${SIBIL_CRON_DIR:-/etc/cron.d}"; }

caddy_site_is_owned() {
    local file="$1"
    [[ -f "$file" ]] && grep -q "$SIBIL_OWNER_MARKER" "$file" 2>/dev/null
}


# نخستین شناسهٔ عددی قابل استفاده از PANEL_ADMINS.
first_admin_id() {
    local raw="$1" item
    raw="$(printf '%s' "$raw" | tr ',\t\r\n' '    ')"
    for item in $raw; do
        if [[ "$item" =~ ^[0-9]+$ ]] && [[ "$item" != 0 ]]; then
            printf '%s' "$item"
            return 0
        fi
    done
    return 1
}

# آپدیت نصب قدیمی فقط یک کلید صریح به .env اضافه می‌کند؛ نه .env و نه فهرست
# مدیران قبلی را بازنویسی نمی‌کند. DB در --migrate با همین مقدار همگام می‌شود.
ensure_primary_owner_anchor() {
    [[ -f "$ENV_FILE" ]] || return 0
    local current admins primary
    current="$(env_get PANEL_PRIMARY_OWNER_ID)"
    [[ "$current" =~ ^[0-9]+$ ]] && [[ "$current" != 0 ]] && return 0
    admins="$(env_get PANEL_ADMINS)"
    [[ -n "$admins" ]] || admins="$(env_get PANEL_ADMIN_IDS)"
    primary="$(first_admin_id "$admins" 2>/dev/null || true)"
    if [[ -n "$primary" ]]; then
        env_set PANEL_PRIMARY_OWNER_ID "$primary"
        chmod 600 "$ENV_FILE" 2>/dev/null || true
        ok "primary owner ID anchored in .env"
    else
        warn "PANEL_PRIMARY_OWNER_ID is missing; add a numeric PANEL_ADMINS ID, then run: sibil migrate"
    fi
}

banner() {
    local title="$CLI_BRAND · v$VERSION"
    local width=38 len pad_l pad_r inner
    len=${#title}
    pad_l=$(( (width - len) / 2 ))
    pad_r=$(( width - len - pad_l ))
    inner="$(printf '%*s%s%*s' "$pad_l" '' "$title" "$pad_r" '')"
    printf '%s%s\n' "$MAG$B" "  ╔══════════════════════════════════════╗"
    printf '%s\n' "  ║${inner}║"
    printf '%s\n' "  ╚══════════════════════════════════════╝$R"
}

# ── بررسی نسخهٔ منتشرشده ────────────────────────────────────────────────────
# قاعده: هر بار که «آپدیت» یا «بررسی» زده می‌شود، نسخهٔ دوردست **تازه** خوانده
# می‌شود؛ هیچ کشی نسخهٔ تازه‌تر را پنهان نمی‌کند. فایل کش فقط زمانی استفاده
# می‌شود که شبکه/گیت‌هاب جواب ندهد (حالت آفلاین).
REMOTE_CACHE="$PANEL_HOME/.update-cache"
DEFAULT_GITHUB_REPO="XuSibiL/SIBILPANEL"
REMOTE_MEM=""          # کش داخل همین اجرا (فقط برای بازترسیم منو)
REMOTE_MEM_AT=0
REMOTE_MEM_TTL=30

version_gt() {   # version_gt A B  → A > B ?
    [[ "$1" == "$2" ]] && return 1
    local IFS=.
    local -a a=($1) b=($2)
    local i
    for i in 0 1 2; do
        local x="${a[$i]:-0}" y="${b[$i]:-0}"
        ((10#$x > 10#$y)) && return 0
        ((10#$x < 10#$y)) && return 1
    done
    return 1
}

# بالاترین نسخهٔ معتبر از میان چند مقدار (خالی‌ها نادیده گرفته می‌شوند)
version_max() {
    local best=""
    local v
    for v in "$@"; do
        v="$(printf '%s' "$v" | tr -d ' \r\n' | sed 's/^[vV]//')"
        [[ "$v" =~ ^[0-9]+(\.[0-9]+)*$ ]] || continue
        if [[ -z "$best" ]] || version_gt "$v" "$best"; then
            best="$v"
        fi
    done
    printf '%s' "$best"
}

_gh_get() {   # _gh_get URL  → بدنه (با هدر no-cache و پارامتر ضدفشرده‌سازی)
    local url="$1"
    command -v curl >/dev/null 2>&1 || return 0
    curl -fsS --max-time 10 -H 'Cache-Control: no-cache' -H 'Pragma: no-cache' \
        -H 'Accept: application/vnd.github+json' \
        "$url$([[ "$url" == *\?* ]] && printf '&' || printf '?')t=$(date +%s)$RANDOM" 2>/dev/null
}

# تگ آخرین ریلیز از خود github.com — بدون مصرف سهمیهٔ API (ریدایرکت ۳۰۲)
_gh_latest_tag() {   # _gh_latest_tag REPO
    local repo="$1" target
    command -v curl >/dev/null 2>&1 || return 0
    target="$(curl -sS --max-time 10 -o /dev/null -H 'Cache-Control: no-cache' \
        -w '%{redirect_url}' "https://github.com/$repo/releases/latest" 2>/dev/null)"
    case "$target" in
        */releases/tag/*)
            target="${target##*/releases/tag/}"
            target="${target%%[?#]*}"
            target="${target#v}"
            [[ "$target" =~ ^[0-9]+(\.[0-9]+)*$ ]] && printf '%s' "$target"
            ;;
    esac
}

# نسخهٔ زندهٔ گیت‌هاب.
# ترتیب اقتصادی: اول فایل VERSION خام (بدون سهمیهٔ API)؛ فقط وقتی همان نسخهٔ
# نصب‌شده را نشان می‌دهد و ممکن است کش‌شده باشد، API گیت‌هاب پرسیده می‌شود.
# نتیجه: در حالت عادی صفر درخواست API، و بلافاصله بعد از انتشار، یک درخواست.
remote_version_live() {
    local repo branch tag contents raw taglist v
    repo="$(git_repo)"
    branch="$(git_branch)"

    # ۱) فایل VERSION خام (سریع، بدون سهمیه)
    raw="$(_gh_get "https://raw.githubusercontent.com/$repo/$branch/VERSION" | head -1)"

    tag=""
    contents=""
    taglist=""
    # ۲) فقط اگر خام نسخهٔ تازه‌تری نشان نداد، API را می‌پرسیم
    #    (ریلیز، بعد Contents API — که برخلاف فایل خام هیچ کش CDN ندارد)
    if [[ -z "$raw" ]] || ! version_gt "$raw" "$VERSION"; then
        # ۲) تگ آخرین ریلیز از github.com — بدون سهمیهٔ API و همان لحظه به‌روز
        tag="$(_gh_latest_tag "$repo")"
        #    اگر ریدایرکت جواب نداد، API رسمی
        if [[ -z "$tag" ]]; then
            tag="$(_gh_get "https://api.github.com/repos/$repo/releases/latest" \
                | sed -n 's/.*"tag_name" *: *"\([^"]*\)".*/\1/p' | head -1)"
        fi
        if [[ -z "$tag" ]] || ! version_gt "${tag#v}" "$VERSION"; then
            contents="$(_gh_get "https://api.github.com/repos/$repo/contents/VERSION?ref=$branch" \
                | sed -n 's/.*"content" *: *"\([^"]*\)".*/\1/p' | head -1 | sed 's/\\n//g')"
            if [[ -n "$contents" ]]; then
                contents="$(printf '%s' "$contents" | base64 -d 2>/dev/null | tr -d ' \r\n')"
            fi
            [[ "$contents" =~ ^[0-9]+(\.[0-9]+)*$ ]] || contents=""
        fi
        if [[ -z "$tag" && -z "$contents" && -z "$raw" ]]; then
            taglist="$(_gh_get "https://api.github.com/repos/$repo/tags?per_page=50" \
                | sed -n 's/.*"name" *: *"\([^"]*\)".*/\1/p' | tr '\n' ' ')"
        fi
    fi

    v="$(version_max "$raw" "$tag" "$contents" $taglist)"
    printf '%s' "$v"
}

# نسخهٔ دوردست برای نمایش/بررسی: تازه، با فایل کش فقط به‌عنوان پشتیبان آفلاین
remote_version() {
    local fresh cached_at cached_v now want
    now="$(date +%s)"

    # کش داخل همین اجرا فقط برای بازترسیم سریع منو (۳۰ ثانیه)
    if [[ -n "$REMOTE_MEM" ]] && ((now - REMOTE_MEM_AT < REMOTE_MEM_TTL)); then
        printf '%s' "$REMOTE_MEM"
        return 0
    fi

    want="$(remote_version_live)"

    if [[ -n "$want" ]]; then
        mkdir -p "$PANEL_HOME" 2>/dev/null
        printf '%s\n%s\n' "$now" "$want" >"$REMOTE_CACHE" 2>/dev/null || true
        REMOTE_MEM="$want"; REMOTE_MEM_AT="$now"
        printf '%s' "$want"
        return 0
    fi

    # آفلاین: آخرین مقدار شناخته‌شده
    if [[ -f "$REMOTE_CACHE" ]]; then
        cached_at="$(sed -n '1p' "$REMOTE_CACHE" 2>/dev/null)"
        cached_v="$(sed -n '2p' "$REMOTE_CACHE" 2>/dev/null)"
        if [[ -n "$cached_v" ]]; then
            printf '%s' "$cached_v"
            return 0
        fi
    fi
    printf '%s' ""
}

# بررسی همیشه‌تازه (برای «update» و «check») — کش را نادیده می‌گیرد
remote_version_now() {
    REMOTE_MEM=""; REMOTE_MEM_AT=0
    remote_version
}

update_available() {
    local remote
    remote="$(remote_version)"
    [[ -n "$remote" ]] && version_gt "$remote" "$VERSION"
}

update_label() {
    local remote
    remote="$(remote_version)"
    [[ -n "$remote" ]] && version_gt "$remote" "$VERSION" \
        && printf ' %s●%s %s(new v%s)%s' "$YEL" "$R" "$DIM" "$remote" "$R"
    return 0
}

update_marker() {
    # نشانگر زرد «آپدیت موجود است»
    local remote
    remote="$(remote_version)"
    [[ -n "$remote" ]] && version_gt "$remote" "$VERSION" && printf '%s●%s' "$YEL" "$R"
    return 0
}

service_active() {
    if has_systemd; then
        bot_unit_is_owned && systemctl is-active --quiet "$SERVICE" 2>/dev/null
    else
        [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null
    fi
}

# Never use a path-derived pgrep/ pkill pattern: PANEL_HOME can contain regex
# characters, and a broad match could stop another customer's process.  /proc
# lets us compare the exact application path as literal text.
app_pids() {
    local proc pid cmd
    [[ -d /proc ]] || return 0
    for proc in /proc/[0-9]*; do
        [[ -r "$proc/cmdline" ]] || continue
        pid="${proc##*/}"
        cmd="$(tr '\000' ' ' <"$proc/cmdline" 2>/dev/null || true)"
        [[ "$cmd" == *"$APP"* ]] && printf '%s\n' "$pid"
    done
}

bot_pids() { app_pids; }

stop_our_app_processes() {
    local pid stopped=0
    while IFS= read -r pid; do
        [[ "$pid" =~ ^[0-9]+$ && "$pid" != "$$" && "$pid" != "${PPID:-0}" ]] || continue
        kill "$pid" 2>/dev/null && stopped=1 || true
    done < <(app_pids)
    [[ "$stopped" == "1" ]]
}

check_env() {
    if [[ ! -f "$ENV_FILE" ]]; then
        bad "no configuration found at $ENV_FILE"
        say "  run the installer first:  sudo bash sibil-installer.sh"
        return 1
    fi
    [[ -f "$APP" ]] || { bad "bot code missing: $APP"; return 1; }
    return 0
}

# ── commands ─────────────────────────────────────────────────────────────────
cmd_start() {
    check_env || return 1
    if service_active; then ok "already running"; return 0; fi
    # بدون systemd هم هیچ runner دوم ساخته نمی‌شود؛ خود PHP هم .poll.lock دارد.
    if ! has_systemd && [[ -n "$(bot_pids)" ]]; then
        ok "already running (existing polling process)"
        return 0
    fi
    if has_systemd && is_root; then
        bot_unit_is_owned || { bad "refusing to start unowned systemd unit: $(bot_unit_file)"; return 1; }
        systemctl reset-failed "$SERVICE" >/dev/null 2>&1 || true
        systemctl start "$SERVICE" && ok "bot service started"
        if web_unit_is_owned; then
            systemctl start "$WEB_SERVICE" 2>/dev/null && ok "payment web endpoint started"
        elif [[ -f "$(web_unit_file)" ]]; then
            warn "preserved unowned web unit: $(web_unit_file)"
        fi
    else
        ( cd "$PANEL_HOME" && nohup "$PHP_BIN" "$APP" --poll >>"$LOG_FILE" 2>&1 & echo $! >"$PID_FILE" )
        ok "bot started (pid $(cat "$PID_FILE" 2>/dev/null))"
    fi
}

cmd_stop() {
    local stopped=0
    if has_systemd && is_root; then
        if bot_unit_is_owned; then systemctl stop "$SERVICE" 2>/dev/null && { ok "bot service stopped"; stopped=1; }; elif [[ -f "$(bot_unit_file)" ]]; then warn "preserved unowned systemd unit: $(bot_unit_file)"; fi
        if web_unit_is_owned; then systemctl stop "$WEB_SERVICE" 2>/dev/null && { ok "web endpoint stopped"; stopped=1; }; elif [[ -f "$(web_unit_file)" ]]; then warn "preserved unowned systemd unit: $(web_unit_file)"; fi
    fi
    if stop_our_app_processes; then ok "local Sibil process stopped"; stopped=1; fi
    rm -f "$PID_FILE"
    [[ "$stopped" == "1" ]] || ok "was not running"
}

# حذف وبهوک تلگرام — این ربات با long polling کار می‌کند
reset_webhook() {
    local token
    token="$(env_get PANEL_BOT_TOKEN)"
    [[ -n "$token" ]] || return 0
    curl -fsS --max-time 10 "https://api.telegram.org/bot$token/deleteWebhook?drop_pending_updates=true" \
        >/dev/null 2>&1 && return 0 || return 1
}

# هم‌تراز کردن دیتابیس با کد فعلی (idempotent، هیچ داده‌ای پاک نمی‌شود)
cmd_migrate() {
    check_env || return 1
    ensure_primary_owner_anchor
    step "Database migration"
    if [[ -f "$PANEL_HOME/migration.php" ]]; then
        PANEL_HOME="$PANEL_HOME" PANEL_ENV="$ENV_FILE" "$PHP_BIN" "$PANEL_HOME/migration.php" "$@"
    else
        PANEL_HOME="$PANEL_HOME" PANEL_ENV="$ENV_FILE" "$PHP_BIN" "$APP" --migrate
    fi
    local rc=$?
    [[ $rc -eq 0 ]] && ok "database is up to date" || bad "migration failed — see logs/bot_error.log"
    return $rc
}

cmd_restart() {
    check_env || return 1
    if has_systemd && is_root && bot_unit_is_owned; then
        systemctl reset-failed "$SERVICE" >/dev/null 2>&1 || true
        systemctl restart "$SERVICE" && ok "bot service restarted"
        if web_unit_is_owned; then
            systemctl reset-failed "$WEB_SERVICE" >/dev/null 2>&1 || true
            systemctl restart "$WEB_SERVICE" 2>/dev/null && ok "payment web endpoint restarted"
        fi
    else
        if has_systemd && is_root && [[ -f "$(bot_unit_file)" ]]; then
            bad "refusing to restart unowned systemd unit: $(bot_unit_file)"
            return 1
        fi
        cmd_stop; sleep 1; cmd_start
    fi
    # وبهوک قبلی پاک می‌شود تا هیچ آپدیتی گم نشود
    if reset_webhook; then
        ok "telegram webhook cleared (long polling mode)"
    else
        warn "webhook could not be cleared (network or token) — run: sibil doctor"
    fi
}

cmd_status() {
    banner
    step "Service"
    if service_active; then ok "bot: running"; else bad "bot: stopped"; fi
    if has_systemd && bot_unit_is_owned; then
        local enabled since
        enabled="$(systemctl is-enabled "$SERVICE" 2>/dev/null | head -1)"
        case "$enabled" in not-found|"") enabled="service not installed" ;; esac
        since="$(systemctl show -p ActiveEnterTimestamp --value "$SERVICE" 2>/dev/null)"
        say "  ${enabled:-not installed}${since:+ · active since $since}"
    elif has_systemd && [[ -f "$(bot_unit_file)" ]]; then
        warn "preserved unowned systemd unit: $(bot_unit_file)"
    fi
    if has_systemd && web_unit_is_owned && systemctl is-active --quiet "$WEB_SERVICE" 2>/dev/null; then
        ok "web endpoint: running ($(env_get PANEL_WEB_URL))"
    else
        warn "web endpoint: stopped (payment callbacks need it)"
    fi
    local pids; pids="$(bot_pids | tr '\n' ' ')"
    [[ -n "${pids// /}" ]] && say "  processes: $pids"
    step "Configuration"
    if [[ -f "$ENV_FILE" ]]; then
        local token admins domain
        token="$(env_get PANEL_BOT_TOKEN)"
        admins="$(env_get PANEL_ADMINS)"; [[ -z "$admins" ]] && admins="$(env_get PANEL_ADMIN_IDS)"
        domain="$(env_get PANEL_DOMAIN)"
        say "  token   : ${token:0:10}…$([[ ${#token} -gt 10 ]] && echo '' || echo ' (missing)')"
        say "  admins  : ${admins:-—}"
        say "  domain  : ${domain:-—}"
    else
        bad "no $ENV_FILE"
    fi
    step "Data"
    if [[ -f "$DB_FILE" ]]; then
        say "  database: $DB_FILE ($(du -h "$DB_FILE" 2>/dev/null | cut -f1))"
        local q
        q="$(db_query "SELECT (SELECT COUNT(*) FROM users) || ' users · ' || (SELECT COUNT(*) FROM panels) || ' panels · ' || (SELECT COUNT(*) FROM pg_panels) || ' panguards'")"
        [[ -n "$q" ]] && say "  $q"
        local pend
        pend="$(db_query "SELECT COUNT(*) FROM receipts WHERE status='pending'")"
        [[ -n "$pend" && "$pend" != "0" ]] && warn "pending receipts: $pend"
    else
        warn "database not created yet"
    fi
    step "Server"
    if command -v free >/dev/null 2>&1; then
        say "  RAM : $(free -h 2>/dev/null | awk 'NR==2{print $3" used / "$2" total"}')"
    fi
    if command -v df >/dev/null 2>&1; then
        say "  DISK: $(df -h "$PANEL_HOME" 2>/dev/null | awk 'NR==2{print $3" used / "$2" total ("$5")"}')"
    fi
    say "  LOAD: $(cut -d' ' -f1-3 /proc/loadavg 2>/dev/null || echo '—') · $(nproc 2>/dev/null || echo '?') cpu"
    step "TLS"
    local dom
    dom="$(env_get PANEL_DOMAIN)"
    if [[ -n "$dom" ]]; then
        local cert="/etc/letsencrypt/live/$dom/cert.pem"
        if [[ -f "$cert" ]] && command -v openssl >/dev/null 2>&1; then
            local end days
            end="$(openssl x509 -enddate -noout -in "$cert" 2>/dev/null | cut -d= -f2)"
            if [[ -n "$end" ]]; then
                days="$(( ( $(date -d "$end" +%s 2>/dev/null || echo 0) - $(date +%s) ) / 86400 ))"
                if ((days > 14)); then ok "certificate for $dom valid for $days day(s)"
                else warn "certificate for $dom expires in $days day(s) — run: sudo sibil ssl"; fi
            fi
        else
            warn "no Let's Encrypt certificate found for $dom"
        fi
    else
        warn "no domain set (online gateways need HTTPS)"
    fi
    step "Logs (last 3 lines each)"
    for f in "$ERR_LOG" "$PAY_LOG"; do
        [[ -f "$f" ]] && { say "  ${DIM}$(basename "$f")${R}"; tail -n 3 "$f" | sed 's/^/    /'; }
    done
    step "Log (last 5 lines)"
    [[ -f "$LOG_FILE" ]] && tail -n 5 "$LOG_FILE" | sed 's/^/  /' || say "  no log yet"
}

ERR_LOG="$PANEL_HOME/logs/bot_error.log"
PAY_LOG="$PANEL_HOME/logs/payments.log"
DEV_LOG="$PANEL_HOME/logs/device_guard.log"

cmd_logs() {
    # بدون آرگومان: زیرمنوی انتخاب فایل لاگ
    if [[ -z "${1:-}" ]] && ! have_tty; then
        cmd_logs err
        return 0
    fi
    if [[ -z "${1:-}" ]]; then
        step "Logs"
        say "  ${B}[1]${R} bot errors   $ERR_LOG"
        say "  ${B}[2]${R} payments     $PAY_LOG"
        say "  ${B}[3]${R} device guard $DEV_LOG"
        say "  ${B}[4]${R} service log  $LOG_FILE"
        local pick
        read -r -p "  choose [1/2/3/4]: " pick </dev/tty || return 0
        case "$pick" in
            2) cmd_logs pay ;;
            3) cmd_logs dev ;;
            4) cmd_logs service ;;
            *) cmd_logs err ;;
        esac
        return 0
    fi
    local file lines="${2:-50}"
    case "$1" in
        pay|payments) file="$PAY_LOG" ;;
        dev|device|devices) file="$DEV_LOG" ;;
        service)      file="$LOG_FILE" ;;
        *)            file="$ERR_LOG" ;;
    esac
    [[ -f "$file" ]] || { warn "no log yet: $file"; say "  (it appears after the first event)"; return 0; }
    say "  ${DIM}$file — Ctrl+C to leave${R}"
    tail -n "$lines" -f "$file"
}

backup_ext() {
    # پسوند اختصاصی این ربات (از تنظیمات دیتابیس، پیش‌فرض panelbak)
    local ext
    ext="$("$PHP_BIN" -r '
        $db = $argv[1];
        $ext = "panelbak";
        if (is_file($db)) {
            try {
                $p = new PDO("sqlite:" . $db, null, null, [PDO::ATTR_ERRMODE => PDO::ERRMODE_SILENT]);
                $v = $p->query("SELECT value FROM settings WHERE key=" . $p->quote("backup_ext"))->fetchColumn();
                if (is_string($v) && $v !== "") { $ext = strtolower(preg_replace("/[^a-z0-9]/i", "", $v)); }
            } catch (Throwable $e) {}
        }
        echo $ext;
    ' "$DB_FILE" 2>/dev/null)"
    [[ -n "$ext" ]] || ext="panelbak"
    printf '%s' "$ext"
}

backup_dir() {
    local dir="${PANEL_BACKUP_DIR:-}"
    if [[ -z "$dir" ]]; then
        if is_root; then dir="/var/backups/sibil"; else dir="$PANEL_HOME/backups"; fi
    fi
    mkdir -p "$dir" 2>/dev/null || dir="$PANEL_HOME/backups"
    mkdir -p "$dir" 2>/dev/null || true
    chmod 700 "$dir" 2>/dev/null || true
    printf '%s' "$dir"
}


# Make a consistent SQLite snapshot without trusting a raw WAL-sidecar copy.
# It is used before irreversible removal; a plain copy is the last fallback.
db_snapshot_to() {
    local src="$1" dest="$2"
    [[ -f "$src" ]] || return 1
    rm -f "$dest"
    "$PHP_BIN" -r '
        try { $p=new PDO("sqlite:".$argv[1]);
            $p->exec("VACUUM INTO " . $p->quote($argv[2])); }
        catch (Throwable $e) { exit(1); }
    ' "$src" "$dest" 2>/dev/null && [[ -s "$dest" ]] && return 0
    rm -f "$dest"
    "$PHP_BIN" -r '
        try { $p=new PDO("sqlite:".$argv[1]); $p->exec("PRAGMA wal_checkpoint(TRUNCATE)"); }
        catch (Throwable $e) { exit(1); }
    ' "$src" 2>/dev/null || true
    cp -f "$src" "$dest" 2>/dev/null && [[ -s "$dest" ]]
}

cmd_backup_create() {
    check_env || return 1
    local dir ext stamp jstamp day out raw envout
    dir="$(backup_dir)"
    mkdir -p "$dir"
    ext="$(backup_ext)"
    stamp="$(date +%Y%m%d-%H%M%S)"
    day="$(date +%Y-%m-%d)"
    jstamp="$("$PHP_BIN" "$APP" --stamp 2>/dev/null | tr -dc '0-9-')"
    if [[ ! -f "$DB_FILE" ]]; then
        bad "nothing to back up (no database yet)"
        return 1
    fi
    # نام استاندارد و تاریخ‌دار: sibil-backup-YYYY-MM-DD.sqlite3 (بازشو با sqlite3)
    out="$dir/sibil-backup-$day.sqlite3"
    [[ -e "$out" ]] && out="$dir/sibil-backup-$day-$stamp.sqlite3"
    raw="$(mktemp)"
    if "$PHP_BIN" "$APP" --dump "$raw" >/dev/null 2>&1; then
        :
    else
        # کپی امن با VACUUM INTO (بدون قفل‌شدن ربات در حال اجرا)
        "$PHP_BIN" -r '
            $src = $argv[1]; $dst = $argv[2];
            try {
                $p = new PDO("sqlite:" . $src);
                $p->exec("VACUUM INTO " . $p->quote($dst));
            } catch (Throwable $e) { copy($src, $dst); }
        ' "$DB_FILE" "$raw" 2>/dev/null || cp -f "$DB_FILE" "$raw"
    fi
    if cp -f "$raw" "$out" 2>/dev/null; then :; else cp -f "$DB_FILE" "$out"; fi
    rm -f "$raw"
    if [[ ! -s "$out" ]]; then
        bad "backup failed: could not write $out"
        return 1
    fi
    chmod 600 "$out" 2>/dev/null || true
    # فایل تنظیمات هم کنار بکاپ نگه داشته می‌شود
    if [[ -f "$ENV_FILE" ]]; then
        envout="$dir/env-$day.env"
        [[ -e "$envout" ]] && envout="$dir/env-$day-$stamp.env"
        cp -f "$ENV_FILE" "$envout" 2>/dev/null && chmod 600 "$envout" 2>/dev/null || true
    fi
    local size
    size="$(du -h "$out" 2>/dev/null | cut -f1)"
    ok "backup written: $out ($size)"
    say "  contains : users, wallets, orders, receipts, panels, KYC (data only, no source)"
    say "  restore  : sibil restore $out"
    ls -1t "$dir" 2>/dev/null | head -5 | sed 's/^/  · /'
}

cmd_backup_import() {
    local file="${1:-}" ext tmp keep validation_err was_running=0 had_db=0 imported_counts restored_counts
    check_env || return 1
    ext="$(backup_ext)"
    service_active && was_running=1
    if [[ -z "$file" ]]; then
        say "  path of the SQLite backup/database to import:"
        read -r -p "  > " file </dev/tty || return 1
        file="$(printf '%s' "$file" | tr -d '\r' | tr -d '\042' | tr -d "\047" | sed -e 's/^ *//' -e 's/ *$//')"
        file="${file/#\~/$HOME}"
    fi
    [[ -n "$file" ]] || { warn "no file given"; return 1; }
    [[ -f "$file" ]] || { bad "file not found: $file"; return 1; }
    local fext
    fext="$(printf '%s' "${file##*.}" | tr '[:upper:]' '[:lower:]')"
    if [[ "$fext" != "$ext" && "$fext" != "sqlite3" && "$fext" != "db" ]]; then
        bad "wrong file type: .$fext — import accepts SQLite .sqlite3, .db or .$ext files"
        return 1
    fi
    step "Validating the import file"
    tmp="$(mktemp "$PANEL_HOME/.sibil-import.XXXXXX")"
    if head -c 2 "$file" | od -An -tx1 | tr -d ' \n' | grep -q '^1f8b'; then
        gzip -dc "$file" >"$tmp" 2>/dev/null || { bad "cannot unpack the backup"; rm -f "$tmp"; return 1; }
    else
        cp -f "$file" "$tmp"
    fi
    if ! head -c 15 "$tmp" | grep -q 'SQLite format 3'; then
        bad "this is not a SQLite database; SQL text dumps are intentionally not executed"
        rm -f "$tmp"
        return 1
    fi
    validation_err="$(mktemp "${TMPDIR:-/tmp}/sibil-import-check.XXXXXX")" || { rm -f "$tmp"; return 1; }
    imported_counts="$("$PHP_BIN" -r '
        $p=new PDO("sqlite:".$argv[1], null, null,[PDO::ATTR_ERRMODE=>PDO::ERRMODE_EXCEPTION]);
        $integrity=(string)$p->query("PRAGMA integrity_check")->fetchColumn();
        if ($integrity!=="ok") { fwrite(STDERR,"integrity=".$integrity); exit(2); }
        $tables=[]; foreach($p->query("SELECT name FROM sqlite_master WHERE type=\"table\"") as $r){$tables[$r[0]]=true;}
        if (!isset($tables["users"])) { fwrite(STDERR,"users table missing"); exit(3); }
        $out=[]; foreach(["users","panels","orders","wallet_tx"] as $t){ if(isset($tables[$t])) $out[$t]=(int)$p->query("SELECT COUNT(*) FROM ".$t)->fetchColumn(); }
        echo json_encode($out);
    ' "$tmp" 2>"$validation_err")" || {
        bad "database validation failed: $(cat "$validation_err" 2>/dev/null)"
        rm -f "$tmp" "$validation_err"
        return 1
    }
    rm -f "$validation_err"
    [[ -n "$imported_counts" ]] || { bad "could not read users from the database"; rm -f "$tmp"; return 1; }
    ok "SQLite integrity check passed; import summary: $imported_counts"

    step "Safety copy of the current data"
    cmd_backup_create >/dev/null 2>&1 && ok "current data saved to $PANEL_HOME/backups" || warn "could not save a named safety copy"
    cmd_stop >/dev/null 2>&1 || true
    keep="$(mktemp "$PANEL_HOME/.sibil-pre-import.XXXXXX")"
    if [[ -f "$DB_FILE" ]]; then
        had_db=1
        "$PHP_BIN" -r '
            try { $p=new PDO("sqlite:".$argv[1]); $p->exec("PRAGMA wal_checkpoint(TRUNCATE)"); }
            catch(Throwable $e) { exit(1); }
        ' "$DB_FILE" 2>/dev/null || warn "could not checkpoint the old database before import"
        # The service is stopped and WAL is checkpointed, so this is a complete rollback image.
        cp -f "$DB_FILE" "$keep" 2>/dev/null || true
    fi

    step "Importing and migrating data"
    cp -f "$tmp" "$DB_FILE" || { bad "could not replace the database"; rm -f "$tmp" "$keep"; return 1; }
    rm -f "$tmp" "$DB_FILE-wal" "$DB_FILE-shm"
    chmod 600 "$DB_FILE" 2>/dev/null || true
    if ! PANEL_HOME="$PANEL_HOME" PANEL_ENV="$ENV_FILE" PANEL_DB="$DB_FILE" "$PHP_BIN" "$APP" --migrate >/dev/null 2>&1; then
        warn "database migration failed — rolling back"
        if [[ "$had_db" == "1" && -s "$keep" ]]; then cp -f "$keep" "$DB_FILE"; else rm -f "$DB_FILE"; fi
        rm -f "$DB_FILE-wal" "$DB_FILE-shm" "$keep"
        [[ "$was_running" == "1" ]] && cmd_start >/dev/null 2>&1
        bad "import cancelled; the previous database state was restored"
        return 1
    fi
    restored_counts="$("$PHP_BIN" -r '
        $p=new PDO("sqlite:".$argv[1]); $out=[];
        foreach(["users","panels","orders","wallet_tx"] as $t){
          $ok=$p->query("SELECT 1 FROM sqlite_master WHERE type=\"table\" AND name=".$p->quote($t))->fetchColumn();
          if($ok!==false) $out[$t]=(int)$p->query("SELECT COUNT(*) FROM ".$t)->fetchColumn();
        } echo json_encode($out);
    ' "$DB_FILE" 2>/dev/null || true)"
    if [[ -z "$restored_counts" ]] || ! "$PHP_BIN" -r '
        $a=json_decode($argv[1],true)?:[]; $b=json_decode($argv[2],true)?:[];
        foreach($a as $k=>$v){ if(!array_key_exists($k,$b) || (int)$b[$k] < (int)$v) exit(1); }' \
        "$imported_counts" "$restored_counts" 2>/dev/null; then
        warn "post-import count verification failed — rolling back"
        if [[ "$had_db" == "1" && -s "$keep" ]]; then cp -f "$keep" "$DB_FILE"; else rm -f "$DB_FILE"; fi
        rm -f "$DB_FILE-wal" "$DB_FILE-shm" "$keep"
        [[ "$was_running" == "1" ]] && cmd_start >/dev/null 2>&1
        bad "import cancelled; source counts were not preserved"
        return 1
    fi
    rm -f "$keep"
    ok "imported and migrated safely: $restored_counts"
    say "  bot token, domain and this server's .env were preserved"
    if reset_webhook; then
        ok "telegram webhook cleared (no updates will be lost)"
    else
        warn "webhook could not be cleared — run: sibil doctor"
    fi
    if [[ "$was_running" == "1" ]]; then
        cmd_start >/dev/null 2>&1 || true
        ok "bot restarted with the imported data"
    else
        ok "start the bot when ready: sibil start"
    fi
}

cmd_backup() {
    local arg="${1:-}"
    step "Backup"
    if [[ -z "$arg" ]] && ! have_tty; then
        # شل غیرتعاملی: پیش‌فرض «همین حالا بکاپ بگیر»
        cmd_backup_create
        return $?
    fi
    if [[ -z "$arg" ]]; then
        say "  ${B}[1]${R} Backup Now            (پشتیبان‌گیری فوری)"
        say "  ${B}[2]${R} Import / Restore Backup (بازیابی بکاپ)"
        local pick
        read -r -p "  choose [1/2]: " pick </dev/tty || return 1
        case "$pick" in
            2) cmd_backup_import "" ; return $? ;;
            *) cmd_backup_create ; return $? ;;
        esac
    fi
    if [[ "$arg" == "create" ]]; then cmd_backup_create; return $?; fi
    cmd_backup_import "$arg"
}

cmd_restore() {
    cmd_backup_import "${1:-}"
}

# ── GitHub update ────────────────────────────────────────────────────────────
git_repo() {
    local repo="${PANEL_UPDATE_REPO:-}"
    [[ -z "$repo" ]] && repo="$(env_get PANEL_UPDATE_REPO 2>/dev/null)"
    [[ -z "$repo" ]] && repo="$DEFAULT_GITHUB_REPO"
    repo="${repo#https://github.com/}"; repo="${repo#http://github.com/}"
    repo="${repo%.git}"; repo="${repo%/}"
    printf '%s' "$repo"
}

git_branch() {
    local branch="${PANEL_UPDATE_BRANCH:-}"
    [[ -z "$branch" ]] && branch="$(env_get PANEL_UPDATE_BRANCH 2>/dev/null)"
    printf '%s' "${branch:-main}"
}

# فایل‌هایی که آپدیت هرگز به آن‌ها دست نمی‌زند: .env · دیتابیس · لاگ · بکاپ · آپلود
UPDATE_KEEP=(.env .env.local .installer-url sibil.sqlite3 panel.sqlite3 sibil.pid
             logs backups uploads tests release)

code_backup() {
    # یک نسخهٔ پشتیبان از «کد» فعلی، قبل از جایگزینی
    local stamp dest
    stamp="$(date +%Y%m%d-%H%M%S)"
    dest="$PANEL_HOME/backups/code-v$VERSION-$stamp.tar.gz"
    mkdir -p "$PANEL_HOME/backups" 2>/dev/null
    tar -czf "$dest" -C "$PANEL_HOME" \
        sibil.php migration.php install.sh VERSION 2>/dev/null
    if [[ -s "$dest" ]]; then
        say "  code backup: $dest"
    else
        warn "could not write a code backup (continuing)"
    fi
}

update_archive() {
    local url="${PANEL_UPDATE_ARCHIVE_URL:-}"
    [[ -n "$url" ]] && { printf '%s' "$url"; return 0; }
    url="$(env_get PANEL_UPDATE_ARCHIVE_URL 2>/dev/null)"
    [[ -n "$url" ]] && { printf '%s' "$url"; return 0; }
    printf 'https://codeload.github.com/%s/tar.gz/refs/heads/%s' "$(git_repo)" "$(git_branch)"
}

github_update() {
    local repo branch remote tmp root f
    local force=""
    [[ "${1:-}" == "--force" || "${1:-}" == "-f" ]] && force="1"
    repo="$(git_repo)"
    branch="$(git_branch)"
    remote="$(remote_version_now)"
    if [[ -z "$force" ]]; then
        if [[ -n "$remote" ]] && ! version_gt "$remote" "$VERSION"; then
            ok "You are on the latest version (v$VERSION) — nothing to update."
            return 0
        fi
        if [[ -n "$remote" ]]; then
            step "Updating v$VERSION -> v$remote  (github.com/$repo, branch $branch)"
        else
            step "Updating from github.com/$repo (branch $branch)"
        fi
    else
        step "Forced update from github.com/$repo (branch $branch)$([[ -n "$remote" ]] && printf ' · github has v%s' "$remote")"
    fi

    command -v curl >/dev/null 2>&1 || { bad "curl is required for the update"; return 1; }
    tmp="$(mktemp -d)"
    local archive; archive="$(update_archive)"
    # هدر no-cache: بستهٔ تازهٔ همان لحظه دانلود می‌شود، نه نسخهٔ کش‌شدهٔ CDN
    if ! curl -fsSL --max-time 120 -H 'Cache-Control: no-cache' -H 'Pragma: no-cache' \
        "$archive" -o "$tmp/code.tgz"; then
        bad "download failed: $archive"
        rm -rf "$tmp"
        return 1
    fi
    if ! tar -xzf "$tmp/code.tgz" -C "$tmp" 2>/dev/null; then
        bad "the downloaded archive could not be extracted"
        rm -rf "$tmp"
        return 1
    fi
    root="$(find "$tmp" -maxdepth 1 -mindepth 1 -type d | head -1)"
    if [[ -z "$root" || ! -f "$root/sibil.php" ]]; then
        bad "the archive does not contain the bot files"
        rm -rf "$tmp"
        return 1
    fi
    if ! "${PHP_BIN:-php}" -l "$root/sibil.php" >/dev/null 2>&1; then
        bad "the downloaded code failed the syntax check — nothing was changed"
        rm -rf "$tmp"
        return 1
    fi

    code_backup

    # فقط فایل‌های کد جایگزین می‌شوند؛ داده و تنظیمات سر جای خودشان می‌مانند
    local items=(sibil.php migration.php install.sh deploy.sh README.md LICENSE VERSION
                 .env.example src bin build docs .github dist)
    local copied=0
    for f in "${items[@]}"; do
        [[ -e "$root/$f" ]] || continue
        if [[ -d "$root/$f" ]]; then
            mkdir -p "$PANEL_HOME/$f"
            cp -Rf "$root/$f/." "$PANEL_HOME/$f/" && copied=$((copied + 1))
        else
            cp -f "$root/$f" "$PANEL_HOME/$f" && copied=$((copied + 1))
        fi
    done
    rm -rf "$tmp"
    ((copied >= 3)) || { bad "nothing was copied — the update was aborted"; return 1; }
    ok "code replaced ($copied items) — .env, database, logs and backups untouched"

    VERSION="$(detect_version)"
    local pkg_version=""
    [[ -f "$PANEL_HOME/VERSION" ]] && pkg_version="$(tr -d ' \r\n' <"$PANEL_HOME/VERSION")"
    if [[ -n "$pkg_version" ]]; then
        ok "installed package version: v$pkg_version"
        if [[ -n "$remote" ]] && [[ "$pkg_version" != "$remote" ]]; then
            warn "the installed files report v$pkg_version while github says v$remote"
            warn "run once: sudo sibil update --force"
        fi
    fi
    ensure_primary_owner_anchor
    if check_env >/dev/null 2>&1 && "${PHP_BIN:-php}" "$APP" --migrate >/dev/null 2>&1; then
        ok "database migrated to the v$VERSION schema"
    else
        warn "database migration reported a problem — run: sudo sibil migrate"
    fi
    rm -f "$REMOTE_CACHE" 2>/dev/null || true

    if service_active; then
        cmd_restart >/dev/null 2>&1 || warn "restart manually: sudo sibil restart"
        ok "service restarted on v$VERSION"
    else
        warn "service is not running — start it with: sudo sibil start"
    fi
    ok "update finished: v$VERSION (data kept)"
    return 0
}

cmd_update() {
    # مسیر اصلی: گیت‌هاب. اگر مخزن در دسترس نبود، نصب‌کنندهٔ تک‌فایلی
    local arg="${1:-}"
    if [[ "$arg" == "--force" || "$arg" == "-f" ]]; then
        github_update --force
    else
        github_update
    fi && return 0
    local url remote
    url="${1:-$(cat "$UPDATE_URL_FILE" 2>/dev/null)}"
    [[ -z "$url" ]] && url="$DEFAULT_UPDATE_URL"
    [[ -z "$url" ]] && return 1
    remote="$(remote_version_now)"
    if [[ -n "$remote" ]] && ! version_gt "$remote" "$VERSION"; then
        ok "You are on the latest version (v$VERSION) — nothing to update."
        return 0
    fi
    step "Fallback: installing from $url"
    local tmp; tmp="$(mktemp -d)/installer.sh"
    if ! curl -fsSL --max-time 60 "$url" -o "$tmp" || [[ ! -s "$tmp" ]]; then
        bad "download failed: $url"
        return 1
    fi
    bash -n "$tmp" || { bad "downloaded installer is broken"; return 1; }
    PANEL_SELF_URL="$url" bash "$tmp" --update
    local rc=$?
    if [[ $rc -eq 0 ]]; then
        rm -f "$REMOTE_CACHE" 2>/dev/null || true
        VERSION="$(detect_version)"
        cmd_migrate >/dev/null 2>&1 && ok "database migrated to the v$VERSION schema"
        ok "updated · now running v$VERSION (database and .env were kept)"
    fi
    return $rc
}

cmd_check() {
    local remote
    remote="$(remote_version_now)"
    say "  local  : v$VERSION"
    # نکته: با ${remote:-…} مقدار تکراری چاپ می‌شد؛ یک متغیر تمیز ساخته می‌شود
    local remote_label="unavailable"
    [[ -n "$remote" ]] && remote_label="v$remote"
    say "  remote : $remote_label"
    say "  source : github.com/$(git_repo) (branch $(git_branch))"
    if [[ -z "$remote" ]]; then
        warn "could not read the remote version (network or repo access)"
        return 1
    fi
    if version_gt "$remote" "$VERSION"; then
        say "  status : update available (run: sudo sibil update)"
        return 0
    fi
    ok "you are on the latest version"
}

domain_dns_check() {
    local dom="$1" ips=""
    if command -v getent >/dev/null 2>&1; then
        ips="$(getent ahosts "$dom" 2>/dev/null | awk '{print $1}' | sort -u | tr '\n' ' ')"
    fi
    if [[ -z "$ips" ]] && command -v dig >/dev/null 2>&1; then
        ips="$(dig +short A "$dom" 2>/dev/null; dig +short AAAA "$dom" 2>/dev/null | head -10 | tr '\n' ' ')"
    fi
    if [[ -z "${ips// /}" ]]; then
        bad "DNS: $dom does not resolve from this server"
        return 1
    fi
    ok "DNS: $dom → ${ips%% }"
    return 0
}

cert_expiry_status() {
    local dom="$1" cert="" end="" days=""
    local le="/etc/letsencrypt/live/$dom/cert.pem"
    if [[ -f "$le" ]]; then
        cert="$le"
    elif command -v timeout >/dev/null 2>&1 && command -v openssl >/dev/null 2>&1; then
        end="$(timeout 12 bash -c "echo | openssl s_client -servername '$dom' -connect '$dom:443' 2>/dev/null | openssl x509 -noout -enddate 2>/dev/null" | cut -d= -f2)"
    fi
    if [[ -n "$cert" && -x "$(command -v openssl 2>/dev/null)" ]]; then
        end="$(openssl x509 -enddate -noout -in "$cert" 2>/dev/null | cut -d= -f2)"
    fi
    if [[ -z "$end" ]]; then
        warn "certificate: not visible yet for $dom"
        return 1
    fi
    days="$(( ( $(date -d "$end" +%s 2>/dev/null || echo 0) - $(date +%s) ) / 86400 ))"
    if (( days > 14 )); then
        ok "certificate: valid for $days day(s)"
    else
        warn "certificate: expires in $days day(s)"
    fi
    return 0
}

caddy_ensure_owned_import() {
    local main dir backup
    main="$(caddy_main_file)"; dir="$(caddy_conf_dir)"
    [[ -f "$main" ]] || { bad "Caddyfile not found: $main"; return 1; }
    mkdir -p "$dir" || { bad "cannot create $dir"; return 1; }
    if grep -qF "$SIBIL_CADDY_IMPORT_BEGIN" "$main" 2>/dev/null; then
        grep -qF "$SIBIL_CADDY_IMPORT_END" "$main" 2>/dev/null || {
            bad "Caddyfile has an incomplete Sibil-owned import section; refusing to edit it"
            return 1
        }
        return 0
    fi
    backup="$main.sibil-backup-$(date +%Y%m%d%H%M%S)"
    cp -fp "$main" "$backup" || { bad "cannot back up $main"; return 1; }
    {
        printf '\n%s\n' "$SIBIL_CADDY_IMPORT_BEGIN"
        printf '# %s — managed import for Sibil only\n' "$SIBIL_OWNER_MARKER"
        printf 'import %s/sibil-*.caddy\n' "$dir"
        printf '%s\n' "$SIBIL_CADDY_IMPORT_END"
    } >>"$main" || { cp -fp "$backup" "$main"; bad "cannot add Sibil import to Caddyfile"; return 1; }
    ok "Sibil-owned Caddy import installed (backup: ${backup##*/})"
}

caddy_write_owned_site() {
    local dom="$1" port file tmp
    port="$(env_get PANEL_WEB_PORT)"; port="${port:-8080}"
    file="$(caddy_site_file "$dom")"
    if [[ -e "$file" ]] && ! caddy_site_is_owned "$file"; then
        bad "refusing to overwrite unowned Caddy file: $file"
        return 1
    fi
    tmp="$(mktemp "${file}.tmp.XXXXXX")" || return 1
    cat >"$tmp" <<EOF
# $SIBIL_OWNER_MARKER
# Sibil payment callback proxy for $dom
$dom {
    reverse_proxy 127.0.0.1:$port
}
EOF
    chmod 644 "$tmp" 2>/dev/null || true
    mv -f "$tmp" "$file" || { rm -f "$tmp"; return 1; }
    ok "Sibil-owned proxy written: $file"
}

caddy_validate_reload() {
    local main
    main="$(caddy_main_file)"
    command -v caddy >/dev/null 2>&1 || { bad "Caddy is not installed"; return 1; }
    if ! caddy validate --config "$main" --adapter caddyfile >/dev/null 2>&1; then
        bad "Caddy validation failed; configuration was not reloaded"
        return 1
    fi
    if has_systemd && is_root; then
        systemctl reload caddy 2>/dev/null || systemctl restart caddy 2>/dev/null \
            || { bad "Caddy could not be reloaded"; return 1; }
        ok "Caddy reloaded; it will obtain/renew certificates automatically"
    else
        warn "configuration is valid; reload Caddy as root to apply it"
    fi
}


# Delete the exact marked import only when its directory is empty.  If another
# .caddy file remains, the import could be serving it, so preservation wins.
caddy_remove_owned_import_if_unused() {
    local main dir tmp leftover
    main="$(caddy_main_file)"; dir="$(caddy_conf_dir)"
    [[ -f "$main" ]] || return 0
    grep -qFx "$SIBIL_CADDY_IMPORT_BEGIN" "$main" 2>/dev/null || return 0
    grep -qFx "$SIBIL_CADDY_IMPORT_END" "$main" 2>/dev/null || {
        warn "preserved incomplete Sibil import section in $main"
        return 1
    }
    local glob='sibil-*.caddy'
    # Older marked imports used *.caddy; preserve that import if any fragment
    # remains because it could be serving a non-Sibil Caddy fragment.
    grep -qF "import $dir/*.caddy" "$main" 2>/dev/null && glob='*.caddy'
    leftover="$(find "$dir" -maxdepth 1 -type f -name "$glob" -print -quit 2>/dev/null || true)"
    if [[ -n "$leftover" ]]; then
        warn "preserved Sibil import; Caddy fragments still exist in $dir"
        return 0
    fi
    tmp="$(mktemp "${main}.sibil-remove.XXXXXX")" || return 1
    if ! awk -v begin="$SIBIL_CADDY_IMPORT_BEGIN" -v end="$SIBIL_CADDY_IMPORT_END" '
        $0 == begin { skipping=1; found=1; next }
        skipping && $0 == end { skipping=0; next }
        !skipping { print }
        END { if (!found || skipping) exit 2 }
    ' "$main" >"$tmp"; then
        rm -f "$tmp"
        warn "preserved Sibil import; could not safely isolate its marker section"
        return 1
    fi
    mv -f "$tmp" "$main" || { rm -f "$tmp"; return 1; }
    ok "removed unused Sibil-owned Caddy import from $main"
}

cmd_domain_status() {
    local dom
    dom="$(normalize_domain "$(env_get PANEL_DOMAIN)")"
    step "Domain and TLS status"
    if [[ -z "$dom" ]]; then
        warn "no Sibil domain is configured"
        return 1
    fi
    say "  domain   : $dom"
    say "  callback : $(env_get PANEL_WEB_URL)"
    domain_dns_check "$dom" || true
    local site; site="$(caddy_site_file "$dom")"
    if caddy_site_is_owned "$site"; then
        ok "proxy: Sibil-owned Caddy site $site"
    elif [[ -e "$site" ]]; then
        warn "proxy file exists but is not Sibil-owned: $site"
    else
        warn "no Sibil-owned Caddy site yet (run: sudo sibil ssl issue)"
    fi
    cert_expiry_status "$dom" || true
}

cmd_domain_health() {
    local dom
    dom="$(normalize_domain "${1:-$(env_get PANEL_DOMAIN)}")"
    [[ -n "$dom" ]] && valid_domain "$dom" || { bad "a valid domain is required"; return 1; }
    step "Domain health: $dom"
    domain_dns_check "$dom" || return 1
    if command -v curl >/dev/null 2>&1; then
        local code
        code="$(curl -ksSIL --max-time 12 -o /dev/null -w '%{http_code}' "https://$dom/" 2>/dev/null || true)"
        [[ "$code" =~ ^[1-5][0-9][0-9]$ ]] && ok "HTTPS responds with HTTP $code" \
            || warn "HTTPS endpoint did not answer yet (DNS/TLS/proxy may still be propagating)"
    fi
    cert_expiry_status "$dom" || true
}

cmd_domain_change() {
    local raw="${1:-}" dom old flag yes=0 force=0
    shift || true
    for flag in "$@"; do
        case "$flag" in
            "") ;;
            --yes|-y) yes=1 ;;
            --force) force=1 ;;
            *) bad "unknown domain-change option: $flag"; return 2 ;;
        esac
    done
    dom="$(normalize_domain "$raw")"
    valid_domain "$dom" || { bad "invalid domain: $raw"; return 1; }
    old="$(normalize_domain "$(env_get PANEL_DOMAIN)")"
    if [[ "$dom" == "$old" ]]; then
        ok "domain is already $dom"
        return 0
    fi
    if ! domain_dns_check "$dom"; then
        [[ "$force" == "1" ]] || { bad "DNS is not ready; fix it first or explicitly pass --force"; return 1; }
        warn "DNS check bypassed explicitly; certificate issue may fail until propagation completes"
    fi
    if [[ "$yes" != "1" ]]; then
        local answer=""
        if have_tty; then
            read -r -p "  Change Sibil callback domain from ${old:-<unset>} to $dom? [y/N] " answer </dev/tty || true
        fi
        [[ "${answer,,}" =~ ^(y|yes)$ ]] || { ok "cancelled — domain was not changed"; return 0; }
    fi
    env_set PANEL_DOMAIN "$dom"
    env_set PANEL_WEB_URL "https://$dom"
    ok "domain saved: $dom"
    say "  next safe step: sudo sibil ssl issue"
}

cmd_domain() {
    check_env || return 1
    local sub="${1:-}" value="${2:-}" yes="${3:-}"
    case "$sub" in
        '' )
            if ! have_tty; then cmd_domain_status; return $?; fi
            while true; do
                cmd_domain_status || true
                say ""
                say "  [1] change domain   [2] DNS / HTTPS health   [3] issue certificate"
                say "  [4] renew certificate [0] return"
                local pick
                read -r -p "  choose: " pick </dev/tty || return 0
                case "$pick" in
                    1) read -r -p "  new domain: " value </dev/tty || value=""; [[ -n "$value" ]] && cmd_domain_change "$value" ;;
                    2) cmd_domain_health ;;
                    3) cmd_ssl issue ;;
                    4) cmd_ssl renew ;;
                    0|q|return|'') return 0 ;;
                    *) warn "unknown choice" ;;
                esac
            done
            ;;
        status) cmd_domain_status ;;
        check|health) cmd_domain_health "$value" ;;
        change) cmd_domain_change "$value" "$yes" "${4:-}" ;;
        issue|renew) cmd_ssl "$sub" ;;
        *) cmd_domain_change "$sub" "$value" "$yes" ;;
    esac
}

cmd_config() {
    check_env || return 1
    step "Configuration editor"
    say "  file: $ENV_FILE"
    say "  token, admins, domain, brand and gateway keys live in this file."
    local mode=""
    if command -v nano >/dev/null 2>&1; then
        say ""
        say "  [1] open in nano (recommended)"
        say "  [2] change the main values one by one"
        read -r -p "  choice [1]: " mode </dev/tty || mode=""
        mode="${mode:-1}"
    else
        warn "nano is not installed — falling back to the guided editor"
        mode="2"
    fi
    if [[ "$mode" == "1" ]]; then
        cp -f "$ENV_FILE" "$ENV_FILE.bak-$(date +%Y%m%d-%H%M%S)" 2>/dev/null || true
        chmod 600 "$ENV_FILE" 2>/dev/null || true
        nano "$ENV_FILE" </dev/tty >/dev/tty 2>&1 || true
        cmd_restart
        return 0
    fi
    local keys=(PANEL_BOT_TOKEN PANEL_ADMINS PANEL_PRIMARY_OWNER_ID PANEL_DOMAIN PANEL_BRAND)
    local key current value
    for key in "${keys[@]}"; do
        current="$(env_get "$key")"
        printf '  %s%s%s = %s\n' "$B" "$key" "$R" "${current:-—}"
        read -r -p "  new value (Enter = keep): " value </dev/tty || value=""
        [[ -n "$value" ]] && { env_set "$key" "$value"; ok "$key updated"; }
    done
    cmd_restart
}

cmd_deps() {
    step "Checking and installing dependencies"
    local -a pkgs=(php-cli php-sqlite3 php-curl php-mbstring php-xml php-zip php-fpm
                   curl jq git cron certbot)
    if command -v apt-get >/dev/null 2>&1; then
        if is_root; then
            DEBIAN_FRONTEND=noninteractive apt-get update -qq >/dev/null 2>&1 || true
            DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${pkgs[@]}" >/dev/null 2>&1 \
                && ok "system packages installed" || warn "some packages could not be installed"
        else
            warn "run as root to install packages: sudo sibil deps"
        fi
    else
        warn "no apt-get — install manually: ${pkgs[*]}"
    fi
    if ! command -v php >/dev/null 2>&1; then
        bad "php is not installed; install php-cli + php-sqlite3 manually"
        return 1
    fi
    say "  php: $PHP_BIN"
    for mod in pdo_sqlite sqlite3 json; do
        "$PHP_BIN" -r "exit(extension_loaded('$mod') ? 0 : 1);" >/dev/null 2>&1 \
            && ok "$mod" || bad "$mod missing (apt install php-sqlite3)"
    done
    [[ -x "$(command -v curl 2>/dev/null)" ]] && ok "curl binary" || warn "curl missing (needed for Telegram)"
}

cmd_php_update() {
    local assume_yes="${1:-}"
    step "PHP runtime update"
    if ! command -v "$PHP_BIN" >/dev/null 2>&1; then
        bad "PHP is not available; run: sudo sibil deps"
        return 1
    fi
    say "  current: $("$PHP_BIN" -v 2>/dev/null | head -1)"
    if [[ "$assume_yes" == "--check" ]]; then
        return 0
    fi
    if ! command -v apt-get >/dev/null 2>&1; then
        warn "no apt-get; update PHP using this platform's package manager, then run: sibil doctor"
        return 1
    fi
    is_root || { warn "run as root: sudo sibil php"; return 1; }
    if [[ "$assume_yes" != "--yes" && "$assume_yes" != "-y" ]]; then
        local answer=""
        if have_tty; then
            read -r -p "  Update installed PHP packages from the configured OS repositories? [y/N] " answer </dev/tty || true
        fi
        [[ "${answer,,}" =~ ^(y|yes)$ ]] || { ok "cancelled — PHP was not changed"; return 0; }
    fi
    local -a pkgs=(php-cli php-common php-sqlite3 php-curl php-mbstring php-xml php-zip)
    DEBIAN_FRONTEND=noninteractive apt-get update -qq \
        && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${pkgs[@]}" \
        && ok "PHP packages updated" || { bad "PHP package update failed"; return 1; }
    PHP_BIN="$(command -v php || printf '%s' "$PHP_BIN")"
    env_set PANEL_PHP_BIN "$PHP_BIN"
    say "  now: $("$PHP_BIN" -v 2>/dev/null | head -1)"
    cmd_restart
}

cmd_doctor() {
    banner
    step "Checks"
    if command -v php >/dev/null 2>&1; then
        ok "php: $("$PHP_BIN" -v 2>/dev/null | head -1)"
    else
        bad "php is missing (option 4 = install dependencies)"
    fi
    "$PHP_BIN" -r 'exit(extension_loaded("pdo_sqlite") ? 0 : 1);' >/dev/null 2>&1 \
        && ok "pdo_sqlite available" || bad "pdo_sqlite missing (see: sudo sibil deps)"
    "$PHP_BIN" -r 'exit(function_exists("curl_init") || trim((string)shell_exec("command -v curl")) !== "" ? 0 : 1);' \
        && ok "http transport ready" || bad "no curl (neither ext-curl nor binary)"
    [[ -f "$APP" ]] && ok "bot code: $APP" || bad "bot code missing"
    "$PHP_BIN" -l "$APP" >/dev/null 2>&1 && ok "code syntax ok" || bad "syntax error in $APP"
    [[ -f "$ENV_FILE" ]] && ok "config: $ENV_FILE" || bad "config missing"
    local token; token="$(env_get PANEL_BOT_TOKEN)"
    if [[ -n "$token" ]]; then
        local api
        api="$(curl -fsS --max-time 8 "https://api.telegram.org/bot$token/getMe" 2>/dev/null)"
        if printf '%s' "$api" | grep -q '"ok":true'; then
            local tguser
            tguser="$(printf '%s' "$api" | sed -n 's/.*"username":"\([^"]*\)".*/\1/p')"
            ok "telegram: @$tguser"
            # یوزرنیم برای لینک دعوت خودکار گرفته می‌شود؛ اگر در .env نبود اضافه می‌شود
            if [[ -n "$tguser" ]] && ! grep -q '^PANEL_BOT_USERNAME=' "$ENV_FILE" 2>/dev/null; then
                printf 'PANEL_BOT_USERNAME="%s"\n' "$tguser" >>"$ENV_FILE" 2>/dev/null \
                    && ok "bot username saved for referral links: @$tguser"
            elif [[ -n "$tguser" ]]; then
                ok "invite link ready: https://t.me/$tguser?start=ref_<id>"
            fi
        else
            bad "telegram rejected the token (invalid or revoked)"
        fi
    else
        bad "no bot token in config"
    fi
    if has_systemd && web_unit_is_owned; then
        systemctl is-active --quiet "$WEB_SERVICE" 2>/dev/null \
            && ok "payment web endpoint is running" \
            || bad "payment web endpoint is down — online gateways cannot confirm"
    elif has_systemd && [[ -f "$(web_unit_file)" ]]; then
        warn "preserved unowned web unit: $(web_unit_file)"
    fi
    local procs; procs="$(bot_pids | wc -l)"
    [[ "$procs" -le 1 ]] && ok "bot processes: $procs" || bad "$procs bot processes are running (409 conflicts) — fix: sudo sibil fix"
    if [[ -f "$DB_FILE" ]]; then
        ok "database: $DB_FILE"
        sed -n '/Data/,$p' <(cmd_status 2>/dev/null) | head -6 | sed 's/^/  /'
    fi
    step "Network"
    local p80=0 p443=0
    if command -v ss >/dev/null 2>&1; then
        ss -ltn 2>/dev/null | grep -qE '(:80|:80 )' && p80=1
        ss -ltn 2>/dev/null | grep -qE '(:443|:443 )' && p443=1
    fi
    [[ $p80 -eq 1 ]] && ok "port 80 is open (HTTP / certificate renewal)" \
        || warn "nothing is listening on port 80 (Let's Encrypt renewal needs it)"
    [[ $p443 -eq 1 ]] && ok "port 443 is open (HTTPS webhook)" \
        || warn "nothing is listening on port 443"
    if command -v caddy >/dev/null 2>&1; then
        if systemctl is-active --quiet caddy 2>/dev/null; then
            ok "caddy is running (TLS + reverse proxy on 80/443)"
        else
            warn "caddy installed but not running — run: sudo systemctl start caddy"
        fi
    else
        warn "caddy not installed — HTTPS/webhook needs it (sudo sibil deps)"
    fi
    if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q 'Status: active'; then
        say "  ufw: $(ufw status 2>/dev/null | grep -cE '80|443') allow rule(s) for 80/443"
    fi
    step "Disk and permissions"
    local free_pct
    free_pct="$(df -P "$PANEL_HOME" 2>/dev/null | awk 'NR==2{gsub("%","",$5); print $5}')"
    if [[ -n "$free_pct" ]]; then
        if ((free_pct >= 90)); then bad "disk is ${free_pct}% full"; else ok "disk used: ${free_pct}%"; fi
    fi
    if [[ -d "$PANEL_HOME" ]]; then
        local perms
        perms="$(stat -c '%a' "$PANEL_HOME" 2>/dev/null)"
        [[ -n "$perms" ]] && say "  $PANEL_HOME → $perms ($(stat -c '%U:%G' "$PANEL_HOME" 2>/dev/null))"
    fi
    for d in logs backups; do
        [[ -d "$PANEL_HOME/$d" ]] && ok "$d/ exists" || warn "$d/ missing (created on first use)"
    done
    [[ -f "$PANEL_HOME/.htaccess" ]] && ok ".htaccess deny rules installed" \
        || warn ".htaccess missing — run: sudo sibil fix"
    step "Telegram webhook info"
    local token2 wh
    token2="$(env_get PANEL_BOT_TOKEN)"
    if [[ -n "$token2" ]]; then
        wh="$(curl -fsS --max-time 8 "https://api.telegram.org/bot$token2/getWebhookInfo" 2>/dev/null)"
        if [[ -n "$wh" ]]; then
            if printf '%s' "$wh" | grep -q '"url":""'; then
                ok "webhook: empty — long polling mode (normal for this bot)"
            else
                say "  webhook url: $(printf '%s' "$wh" | sed -n 's/.*"url":"\([^"]*\)".*/\1/p')"
            fi
            local pending
            pending="$(printf '%s' "$wh" | sed -n 's/.*"pending_update_count":\([0-9]*\).*/\1/p')"
            [[ -n "$pending" ]] && say "  pending updates: $pending"
        else
            warn "getWebhookInfo returned nothing (network?)"
        fi
    fi
    step "Device guard (logs/device_guard.log)"
    if [[ -f "$DEV_LOG" ]]; then
        say "  last events:"
        tail -n 3 "$DEV_LOG" | sed 's/^/  · /'
    else
        say "  no device-guard event yet"
    fi
    step "Config check (sibil.php --check)"
    PANEL_HOME="$PANEL_HOME" PANEL_ENV="$ENV_FILE" PANEL_DB="$DB_FILE" "$PHP_BIN" "$APP" --check 2>&1 | sed 's/^/  /'
}

cmd_ssl() {
    local action="${1:-}" dom
    dom="$(normalize_domain "$(env_get PANEL_DOMAIN)")"
    if [[ "$action" == "status" ]]; then
        cmd_domain_status
        return $?
    fi
    [[ -n "$dom" ]] && valid_domain "$dom" || { bad "set a valid domain first: sibil domain change example.com"; return 1; }
    if [[ "$action" == "" ]] && have_tty; then
        say "  [1] status   [2] issue / repair certificate   [3] renew now   [0] return"
        local pick
        read -r -p "  SSL choice: " pick </dev/tty || return 0
        case "$pick" in 1) action=status ;; 2) action=issue ;; 3) action=renew ;; *) return 0 ;; esac
        [[ "$action" == status ]] && { cmd_domain_status; return $?; }
    fi
    [[ -n "$action" ]] || action=status
    case "$action" in
        issue|renew)
            # System Caddy paths require root.  A deliberately overridden, writable
            # Caddy configuration may be managed by an unprivileged local install.
            if ! is_root && { [[ "$(caddy_main_file)" == "/etc/caddy/Caddyfile" ]] || [[ "$(caddy_conf_dir)" == "/etc/caddy/conf.d" ]]; }; then
                bad "run as root: sudo sibil ssl $action"
                return 1
            fi
            domain_dns_check "$dom" || { bad "fix DNS before issuing a certificate"; return 1; }
            command -v caddy >/dev/null 2>&1 || { bad "Caddy is not installed; run: sudo sibil deps"; return 1; }
            local main site main_backup site_backup="" site_existed=0
            main="$(caddy_main_file)"; site="$(caddy_site_file "$dom")"
            [[ -f "$main" ]] || { bad "Caddyfile not found: $main"; return 1; }
            main_backup="$(mktemp "${main}.sibil-rollback.XXXXXX")" || return 1
            cp -fp "$main" "$main_backup" || { rm -f "$main_backup"; return 1; }
            if [[ -f "$site" ]]; then
                site_existed=1
                site_backup="$(mktemp "${site}.sibil-rollback.XXXXXX")" || { rm -f "$main_backup"; return 1; }
                cp -fp "$site" "$site_backup" || { rm -f "$main_backup" "$site_backup"; return 1; }
            fi
            if ! caddy_ensure_owned_import || ! caddy_write_owned_site "$dom" || ! caddy_validate_reload; then
                cp -fp "$main_backup" "$main" 2>/dev/null || true
                if [[ "$site_existed" == "1" ]]; then cp -fp "$site_backup" "$site" 2>/dev/null || true; else rm -f "$site"; fi
                rm -f "$main_backup" "$site_backup"
                warn "Caddy changes did not validate; restored the previous configuration"
                return 1
            fi
            rm -f "$main_backup" "$site_backup"
            [[ "$action" == issue ]] && say "  certificate issuance is asynchronous; run 'sibil domain health' in a moment"
            cert_expiry_status "$dom" || true
            ;;
        *) bad "usage: sibil ssl [status|issue|renew]"; return 2 ;;
    esac
}

cmd_fix() {
    step "Repairing permissions and processes"
    mkdir -p "$PANEL_HOME/logs" "$PANEL_HOME/backups" 2>/dev/null || true
    chmod 750 "$PANEL_HOME/logs" "$PANEL_HOME/backups" 2>/dev/null || true
    install_htaccess
    if is_root; then
        stop_our_app_processes && warn "stray Sibil processes stopped"
        [[ -d "$PANEL_HOME" ]] && chown -R sibil:sibil "$PANEL_HOME" 2>/dev/null && ok "ownership fixed"
        if has_systemd && bot_unit_is_owned; then
            systemctl reset-failed "$SERVICE" >/dev/null 2>&1 || true
            systemctl restart "$SERVICE" && ok "service restarted"
        elif has_systemd && [[ -f "$(bot_unit_file)" ]]; then
            warn "preserved unowned systemd unit: $(bot_unit_file)"
        fi
        [[ -f "$LOG_FILE" ]] && { tail -n 15 "$LOG_FILE" | sed 's/^/  /'; }
    else
        bad "run as root: sudo sibil fix"
    fi
}

cmd_install() {
    local url="${1:-${DEFAULT_UPDATE_URL:-$OFFICIAL_INSTALL_URL}}"
    step "Installing $CLI_BRAND (PHP $VERSION)"
    local tmp; tmp="$(mktemp -d)/installer.sh"
    curl -fsSL --max-time 60 "$url" -o "$tmp" || { bad "download failed"; return 1; }
    sudo bash "$tmp"
}

cmd_remove() {
    step "Removing the Sibil service (data and CLI are kept)"
    local unit="$SYSTEMD_DIR/$SERVICE.service" webunit="$SYSTEMD_DIR/$WEB_SERVICE.service"
    if ! panel_home_owned; then
        bad "refusing service removal: $PANEL_HOME is not proven to be Sibil-owned"
        return 1
    fi
    for unit in "$unit" "$webunit"; do
        if unit_is_owned "$unit"; then
            if has_systemd && is_root; then
                systemctl stop "$(basename "$unit" .service)" 2>/dev/null || true
                systemctl disable "$(basename "$unit" .service)" 2>/dev/null || true
            fi
            rm -f "$unit" && ok "removed $(basename "$unit")"
        elif [[ -f "$unit" ]]; then
            warn "preserved unowned systemd unit: $unit"
        fi
    done
    if has_systemd && is_root && [[ -d "$SYSTEMD_DIR" ]]; then systemctl daemon-reload 2>/dev/null || true; fi
    stop_our_app_processes || true
    ok "Sibil service removed; data, source and CLI remain in $PANEL_HOME"
    say "  to remove all proven Sibil resources: sudo sibil uninstall"
}

# ── حذف کامل (uninstall) ─────────────────────────────────────────────────────
# کل نصب را پاک می‌کند: سرویس‌ها، فایل سرویس، پوشهٔ نصب، دستور ترمینال و
# بلوک دامنه در کانفیگ وب‌سرور. قبل از هر کار یک بکاپ امن در /root گرفته می‌شود
# تا حذف تصادفی دیتابیس جبران‌پذیر باشد.
remove_caddy_block() {
    local domain="$1" file main main_backup site_backup="" site_existed=0
    [[ -n "$domain" ]] || return 0
    file="$(caddy_site_file "$domain")"; main="$(caddy_main_file)"
    if caddy_site_is_owned "$file"; then
        # Save exact files before a removal that could make a hand-edited Caddyfile
        # invalid.  The backup is removed once validation succeeds.
        [[ -f "$main" ]] && {
            main_backup="$(mktemp "${main}.sibil-remove-rollback.XXXXXX")" || return 1
            cp -fp "$main" "$main_backup" || { rm -f "$main_backup"; return 1; }
        }
        site_existed=1
        site_backup="$(mktemp "${file}.sibil-remove-rollback.XXXXXX")" || { rm -f "$main_backup"; return 1; }
        cp -fp "$file" "$site_backup" || { rm -f "$main_backup" "$site_backup"; return 1; }
        rm -f "$file" || { rm -f "$main_backup" "$site_backup"; return 1; }
        ok "removed Sibil-owned Caddy site: $file"
        caddy_remove_owned_import_if_unused || true
        if command -v caddy >/dev/null 2>&1 && [[ -f "$main" ]] && ! caddy validate --config "$main" --adapter caddyfile >/dev/null 2>&1; then
            [[ -n "$main_backup" ]] && cp -fp "$main_backup" "$main" 2>/dev/null || true
            [[ "$site_existed" == "1" ]] && cp -fp "$site_backup" "$file" 2>/dev/null || true
            rm -f "$main_backup" "$site_backup"
            warn "Caddy validation failed after cleanup; restored the Sibil files"
            return 1
        fi
        rm -f "$main_backup" "$site_backup"
        if command -v caddy >/dev/null 2>&1 && [[ -f "$main" ]] && has_systemd && is_root; then
            systemctl reload caddy 2>/dev/null || true
        fi
    elif [[ -e "$file" ]]; then
        warn "preserved unowned Caddy file: $file"
    elif [[ -f "$main" ]] && grep -qF "$domain" "$main" 2>/dev/null; then
        warn "preserved legacy/unmarked Caddy entry for $domain (not safe to delete automatically)"
    fi
}

remove_nginx_block() {
    local domain="$1" f removed=0 i
    local -a files=() backups=()
    [[ -n "$domain" ]] || return 0
    # Only Sibil-named, explicitly marked files are ours.  A server_name match
    # is deliberately insufficient: it could belong to another application.
    for f in "$(nginx_sites_enabled_dir)/sibil-$domain" "$(nginx_sites_available_dir)/sibil-$domain" \
             "$(nginx_conf_dir)/sibil-$domain.conf"; do
        [[ -f "$f" ]] || continue
        if ! grep -q "$SIBIL_OWNER_MARKER" "$f" 2>/dev/null; then
            warn "preserved unowned nginx file: $f"
            continue
        fi
        local backup
        backup="$(mktemp "${f}.sibil-remove-rollback.XXXXXX")" || return 1
        cp -fp "$f" "$backup" || { rm -f "$backup"; return 1; }
        rm -f "$f" || { rm -f "$backup"; return 1; }
        files+=("$f"); backups+=("$backup"); removed=1
        ok "removed Sibil-owned nginx file: $f"
    done
    if [[ $removed -eq 1 ]] && command -v nginx >/dev/null 2>&1; then
        if ! nginx -t >/dev/null 2>&1; then
            for i in "${!files[@]}"; do cp -fp "${backups[$i]}" "${files[$i]}" 2>/dev/null || true; done
            rm -f "${backups[@]}"
            warn "nginx validation failed after cleanup; restored the Sibil files"
            return 1
        fi
        if has_systemd && is_root; then systemctl reload nginx 2>/dev/null || true; fi
    fi
    [[ ${#backups[@]} -gt 0 ]] && rm -f "${backups[@]}"
}


# Sibil itself uses systemd, but old installs may have left a /etc/cron.d file.
# Only explicitly marked files—or conservative exact-home legacy proof—are touched.
remove_owned_cron_files() {
    local dir f failed=0
    dir="$(cron_dir)"
    for f in "$dir/sibil" "$dir/sibilpanel" "$dir/sibil-panel"; do
        [[ -f "$f" ]] || continue
        if grep -q "$SIBIL_OWNER_MARKER" "$f" 2>/dev/null \
           || { grep -qF "$PANEL_HOME/sibil.php" "$f" 2>/dev/null && grep -qF "$PANEL_HOME" "$f" 2>/dev/null; }; then
            if rm -f "$f"; then ok "removed Sibil-owned cron file: $f"; else warn "could not remove owned cron file: $f"; failed=1; fi
        else
            warn "preserved unowned cron file: $f"
        fi
    done
    return "$failed"
}

cmd_uninstall() {
    local assume_yes="${1:-}" domain unit removed_units=0 keep
    domain="$(normalize_domain "$(env_get PANEL_DOMAIN)")"
    [[ -n "$domain" ]] || domain="$(normalize_domain "$(env_get PANEL_WEB_DOMAIN)")"
    if ! panel_home_owned; then
        bad "refusing uninstall: $PANEL_HOME is not proven to be Sibil-owned"
        say "  expected .sibil-owned, or matching .env + sibil.php ownership proof"
        return 1
    fi

    banner
    say ""
    warn "this removes only resources proven to belong to this Sibil installation"
    say "  install dir : ${B}$PANEL_HOME${R}"
    say "  database    : ${B}$DB_FILE${R}"
    say "  command     : ${B}$CLI_PATH${R}"
    [[ -n "$domain" ]] && say "  domain      : ${B}$domain${R}"
    say "  preserved   : unmarked web-server files, unrelated services and other app data"
    if [[ -f "$DB_FILE" ]] && ! db_file_is_under_home; then
        warn "configured database is outside the Sibil home and will be preserved: $DB_FILE"
    fi
    say ""

    if [[ "$assume_yes" != "-y" && "$assume_yes" != "--yes" ]]; then
        local answer=""
        if ! read -r -p "  Remove this Sibil installation and its data? [y/N] " answer </dev/tty 2>/dev/null; then
            read -r -p "  Remove this Sibil installation and its data? [y/N] " answer 2>/dev/null || answer=""
        fi
        case "${answer,,}" in
            y|yes) ;;
            *) say ""; ok "cancelled — nothing was changed"; return 0 ;;
        esac
    fi

    step "1/6 stopping Sibil-owned services"
    for unit in "$SYSTEMD_DIR/$SERVICE.service" "$SYSTEMD_DIR/$WEB_SERVICE.service"; do
        if unit_is_owned "$unit"; then
            if has_systemd && is_root; then
                systemctl stop "$(basename "$unit" .service)" 2>/dev/null || true
            fi
            ok "stopped $(basename "$unit")"
        elif [[ -f "$unit" ]]; then
            warn "preserved unowned systemd unit: $unit"
        fi
    done
    # Only this installation's executable is targeted; broad sibil/process-name
    # kills could terminate a different customer's service.
    stop_our_app_processes || true

    step "2/6 preserving a recoverable data copy"
    if [[ -f "$DB_FILE" ]]; then
        if [[ -n "${SIBIL_UNINSTALL_BACKUP_DIR:-}" ]]; then
            keep="$SIBIL_UNINSTALL_BACKUP_DIR/sibil-uninstall-$(date +%Y%m%d-%H%M%S)"
        elif is_root; then keep="/root/sibil-uninstall-$(date +%Y%m%d-%H%M%S)"; else keep="$HOME/sibil-uninstall-$(date +%Y%m%d-%H%M%S)"; fi
        if ! mkdir -p "$keep" 2>/dev/null || ! db_snapshot_to "$DB_FILE" "$keep/sibil.sqlite3"; then
            rm -rf -- "$keep" 2>/dev/null || true
            bad "could not make a recoverable database snapshot; refusing to delete the Sibil home"
            return 1
        fi
        [[ -f "$ENV_FILE" ]] && cp -f "$ENV_FILE" "$keep/.env" 2>/dev/null || true
        chmod 600 "$keep"/* 2>/dev/null || true
        ok "data copy kept in $keep"
    fi

    step "3/6 removing Sibil-owned service units"
    for unit in "$SYSTEMD_DIR/$SERVICE.service" "$SYSTEMD_DIR/$WEB_SERVICE.service"; do
        if unit_is_owned "$unit"; then
            if has_systemd && is_root; then systemctl disable "$(basename "$unit" .service)" 2>/dev/null || true; fi
            rm -f "$unit" && { removed_units=$((removed_units + 1)); ok "removed $unit"; }
        fi
    done
    if [[ $removed_units -gt 0 ]] && has_systemd && is_root && [[ -d "$SYSTEMD_DIR" ]]; then
        systemctl daemon-reload 2>/dev/null || true
        systemctl reset-failed "$SERVICE" 2>/dev/null || true
        systemctl reset-failed "$WEB_SERVICE" 2>/dev/null || true
    fi

    step "4/6 removing Sibil-owned commands and web proxy files"
    local cli cleanup_failed=0
    for cli in "$CLI_PATH" /usr/local/bin/sibil /usr/bin/sibil; do
        if cli_is_owned "$cli"; then
            rm -f -- "$cli" && ok "removed Sibil command: $cli"
        elif [[ -e "$cli" || -L "$cli" ]]; then
            warn "preserved unowned command: $cli"
        fi
    done
    remove_caddy_block "$domain" || cleanup_failed=1
    remove_nginx_block "$domain" || cleanup_failed=1
    remove_owned_cron_files || cleanup_failed=1
    if [[ "$cleanup_failed" == "1" ]]; then
        bad "web/cron cleanup was rolled back or incomplete; Sibil source and data were preserved"
        return 1
    fi

    step "5/6 removing the proven Sibil home"
    rm -rf -- "$PANEL_HOME" 2>/dev/null || { bad "could not remove $PANEL_HOME"; return 1; }
    ok "installation directory removed: $PANEL_HOME"

    step "6/6 final ownership check"
    local leftovers=0
    [[ -d "$PANEL_HOME" ]] && leftovers=$((leftovers+1))
    for unit in "$SYSTEMD_DIR/$SERVICE.service" "$SYSTEMD_DIR/$WEB_SERVICE.service"; do
        unit_is_owned "$unit" && leftovers=$((leftovers+1))
    done
    if [[ $leftovers -gt 0 ]]; then
        warn "$leftovers owned resource(s) remain; review permissions manually"
        return 1
    fi
    say ""
    printf '  %s✓ Sibil was safely uninstalled; unrelated server resources were preserved.%s\n' "$GRN$B" "$R"
    say ""
}

# ── قواعد امنیتی وب (دسترسی مستقیم به لاگ/بکاپ/کانفیگ بسته می‌شود) ──────────
install_htaccess() {
    local target="$PANEL_HOME/.htaccess"
    cat >"$target" <<'HTACCESS'
# deny direct web access to private files
Options -Indexes
<FilesMatch "(\.env|\.sqlite3|\.sqlite3-.*|\.db|\.sql(\.gz)?|\.panelbak|sibil\.php\.bak.*|\.log)$">
    Require all denied
</FilesMatch>
RedirectMatch 404 /(\.env|logs/|backups/|.*\.sqlite3|.*\.sql(\.gz)?|.*\.panelbak)
HTACCESS
    chmod 644 "$target" 2>/dev/null || true
    ok "web access rules installed: $target"

    # حذف اجرای PHP در پوشهٔ آپلود/موقت
    local up="$PANEL_HOME/uploads"
    mkdir -p "$up" 2>/dev/null || true
    printf 'php_flag engine off\n<FilesMatch "\.(php|phtml|phar)$">\n    Require all denied\n</FilesMatch>\n' \
        >"$up/.htaccess" 2>/dev/null || true
}

cmd_help() {
    banner
    say ""
    say "  ${B}usage:${R} sibil [command]"
    say ""
    say "  ${B}Operational${R}"
    say "    ${B}install${R}          install / repair from the official source"
    say "    ${B}update${R}           update code safely (keeps .env and database)"
    say "    ${B}remove${R}           remove only proven Sibil services; keep data"
    say "    ${B}uninstall${R}        remove all proven Sibil resources (asks first)"
    say "    ${B}php${R}              update PHP runtime packages (asks first)"
    say "    ${B}start${R} / ${B}stop${R} / ${B}restart${R}    service controls"
    say ""
    say "  ${B}Domain and TLS${R}"
    say "    ${B}domain status|change <name>|health${R}"
    say "    ${B}ssl status|issue|renew${R}    owned Caddy proxy/certificate actions"
    say ""
    say "  ${B}Data and support${R}"
    say "    ${B}backup${R}           create a database snapshot"
    say "    ${B}import <file>${R}    validate, safety-copy and restore a database"
    say "    ${B}migrate${R}          run compatible database migrations"
    say "    ${B}status${R} / ${B}doctor${R} / ${B}web${R} / ${B}logs${R}"
    say "    ${B}config${R} / ${B}deps${R} / ${B}fix${R} / ${B}check${R}"
    say ""
    say "  Safety: uninstall and proxy cleanup only remove files with explicit Sibil"
    say "  ownership proof; unrelated server resources are preserved."
    say ""
}

dashboard_health_row() {
    local bot='● stopped' web='● down' db='● missing' tls='● unset' dom
    service_active && bot='● running'
    if has_systemd && web_unit_is_owned && systemctl is-active --quiet "$WEB_SERVICE" 2>/dev/null; then web='● online'; fi
    [[ -f "$DB_FILE" ]] && db='● ready'
    dom="$(normalize_domain "$(env_get PANEL_DOMAIN)")"
    [[ -n "$dom" ]] && tls="● $dom"
    printf '  %sBOT %s  %sWEB %s  %sDB %s  %sTLS %s%s\n' \
        "$DIM" "$bot" "$DIM" "$web" "$DIM" "$db" "$DIM" "$tls" "$R"
}

cmd_menu() {
    local choice remote
    if [[ ! -e /dev/tty ]] || { [[ ! -t 0 ]] && [[ ! -t 1 ]]; }; then
        banner
        warn "no interactive terminal — run: sibil help"
        return 0
    fi
    while true; do
        clear 2>/dev/null || true
        banner
        dashboard_health_row
        remote="$(remote_version)"
        if [[ -n "$remote" ]] && version_gt "$remote" "$VERSION"; then
            printf '\n  %s● Update v%s is available. You have v%s.%s\n' "$YEL$B" "$remote" "$VERSION" "$R"
        fi
        say ""
        say "  ${B}[1]${R} Install / repair       ${B}[2]${R} Update              ${B}[3]${R} Remove service"
        say "  ${B}[4]${R} PHP update             ${B}[5]${R} Domain / SSL        ${B}[6]${R} Backup / DB import"
        say "  ${B}[7]${R} Database migration     ${B}[8]${R} Status / health     ${B}[9]${R} Help / parameters"
        say "  ${B}[10]${R} Config / logs          ${B}[0]${R} Exit"
        say ""
        read -r -p "  choose: " choice </dev/tty || return 0
        say ""
        case "$choice" in
            1) cmd_install ;;
            2) cmd_update ;;
            3) cmd_remove ;;
            4) cmd_php_update ;;
            5) cmd_domain ;;
            6) cmd_backup "" ;;
            7) cmd_migrate ;;
            8) cmd_status; cmd_doctor ;;
            9) cmd_help ;;
            10) cmd_config ; cmd_logs "" ;;
            0|q|exit|'') return 0 ;;
            *) warn "unknown choice: $choice" ;;
        esac
        [[ -n "${PANEL_NO_PAUSE:-}" ]] && continue
        say ""
        read -r -p "  press Enter to return to the menu… " _ </dev/tty 2>/dev/null || true
    done
}

case "${1:-menu}" in
    status)  cmd_status ;;
    update)  shift; cmd_update "${1:-}" ;;
    restart) cmd_restart ;;
    start)   cmd_start ;;
    stop)    cmd_stop ;;
    logs)    shift; cmd_logs "${1:-60}" ;;
    backup)  shift; cmd_backup "${1:-}" ;;
    restore) shift; cmd_restore "${1:-}" ;;
    import|db-import) shift; cmd_backup_import "${1:-}" ;;
    domain)  shift; cmd_domain "$@" ;;
    config)  cmd_config ;;
    doctor)  cmd_doctor ;;
    deps)    cmd_deps ;;
    php|php-update) shift; cmd_php_update "${1:-}" ;;
    migrate|migration) shift; cmd_migrate "$@" ;;
    ssl)     shift; cmd_ssl "$@" ;;
    fix)     cmd_fix ;;
    install) shift; cmd_install "${1:-}" ;;
    remove)  cmd_remove ;;
    uninstall) shift; cmd_uninstall "${1:-}" ;;
    web)
        port="$(env_get PANEL_WEB_PORT)"; port="${port:-8080}"
        say "web endpoint : ${WEB_SERVICE} (php -S 0.0.0.0:$port)"
        say "callback base: $(env_get PANEL_WEB_URL)"
        say "gateways     : ${PANEL_WEB_URL:-<unset>}/pay/<gateway>"
        say "variza hook  : ${PANEL_WEB_URL:-<unset>}/pay/variza/webhook"
        say "tetrapay hook: ${PANEL_WEB_URL:-<unset>}/pay/tetrapay/webhook"
        if has_systemd && web_unit_is_owned; then systemctl status "$WEB_SERVICE" --no-pager -n 5 2>/dev/null; fi
        ;;
    version) say "$CLI_BRAND $VERSION (PHP edition)" ;;
    check|update-check) cmd_check ;;
    help|-h|--help) cmd_help ;;
    menu)    cmd_menu ;;
    *) bad "unknown command: $1"; cmd_help; exit 1 ;;
esac
